000000r 1               ; =============================================================================
000000r 1               ;   Pong.asm - cartridge entry point and main loop
000000r 1               ; =============================================================================
000000r 1               ;   Classic Pong for the AC6502 family, built as a standalone ROM cartridge
000000r 1               ;   (6502-CRT template). Boots directly, no BASIC. One-player (vs a CPU
000000r 1               ;   paddle) and two-player local modes, chosen on the title screen.
000000r 1               ;
000000r 1               ;   Controls: joystick, either port, to move, with WASD (P1) / arrow keys
000000r 1               ;   (P2) as a keyboard fallback -- see src/input.asm. Up/down navigates
000000r 1               ;   the title screen's mode select, and the A button (or space) confirms
000000r 1               ;   it, pauses/resumes during play, and restarts after game over.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               .include "6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc - External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) - uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for a program that has taken the machine over
000000r 2               ;                 (not underneath a running BASIC, which uses it as it interprets)
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$04FF   BAS_LINBUF: BASIC's raw input line (NOT user memory, despite
000000r 2               ;                 BIOS.inc naming $0400 USER_VARS -- a legacy name kept only
000000r 2               ;                 because Wozmon builds its input buffer there)
000000r 2               ;   $0500-$05FF   BAS_TOKBUF: BASIC's tokenizing scratch
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB - load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA - keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt - cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked - if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active - centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS - interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes - String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes - CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes - CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes - XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes - IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes - BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes - NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  - Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  - Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  - Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  - Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  - Current CF disk bank (0-255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA - keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes - XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  - Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes - Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes - Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes - File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes - End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF - 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact - the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert - nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW - each line is pulled up through 1K and grounded
000000r 2               ;   by its switch - and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT - with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0-255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt - caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0-255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0-255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable - set to inhibit clock updates during write
000000r 2               ; Month register ($8805) - the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W - Data register
000000r 2               ST_ERROR            := $8C01             ; Read - Error register
000000r 2               ST_FEATURE          := $8C01             ; Write - Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W - Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W - LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W - LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W - LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W - LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read - Status register
000000r 2               ST_CMD              := $8C07             ; Write - Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request - ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy - all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W - Data register
000000r 2               SC_RESET            := $9001             ; Write - Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read - Status register
000000r 2               SC_CMD              := $9002             ; R/W - Command register
000000r 2               SC_CTRL             := $9003             ; R/W - Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) - middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register - not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W - VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write - Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read - Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               .include "src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc - Pong zero-page variables and game constants
000000r 2               ; =============================================================================
000000r 2               ;   Zero page $3A-$FF is free for a program that has taken the machine over
000000r 2               ;   (see SECTION 1 of 6502.inc). 6502.cfg defines no RAM/BSS segment, so
000000r 2               ;   every variable below is a fixed-address equate (:=), not a
000000r 2               ;   .zeropage/.bss allocation. No RAM arrays needed outside zero page:
000000r 2               ;   Pong (unlike Snake) has no ring buffers or occupancy grid to track.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Game state constants ---
000000r 2               STATE_TITLE     = 0
000000r 2               STATE_PLAYING   = 1
000000r 2               STATE_PAUSED    = 2
000000r 2               STATE_GAMEOVER  = 3
000000r 2               
000000r 2               MODE_1P         = 0   ; vs CPU
000000r 2               MODE_2P         = 1   ; two human players
000000r 2               
000000r 2               DIR_NONE        = 0
000000r 2               DIR_UP          = 1
000000r 2               DIR_DOWN        = 2
000000r 2               
000000r 2               ; --- Zero page variables ---
000000r 2               GAME_STATE      := $3A   ; STATE_*
000000r 2               GAME_MODE       := $3B   ; MODE_1P / MODE_2P
000000r 2               P1_Y            := $3C   ; left paddle top row (paddle spans P1_Y..P1_Y+3)
000000r 2               P2_Y            := $3D   ; right paddle top row
000000r 2               BALL_X          := $3E
000000r 2               BALL_Y          := $3F
000000r 2               BALL_DX         := $40   ; two's complement: $01 = +1 (right), $FF = -1 (left)
000000r 2               BALL_DY         := $41   ; $01 = +1 (down), $FF = -1 (up), $00 = flat
000000r 2               P1_SCORE        := $42   ; 0-99 in practice (WIN_SCORE caps play well under that)
000000r 2               P2_SCORE        := $43
000000r 2               RNG_STATE       := $44   ; 8-bit LFSR state (never 0)
000000r 2               NEXT_P1         := $45   ; DIR_NONE/DIR_UP/DIR_DOWN, buffered each poll
000000r 2               NEXT_P2         := $46   ; DIR_NONE/DIR_UP/DIR_DOWN (2P mode only; CPU drives P2 in 1P)
000000r 2               HIT_COUNT       := $47   ; paddle hits so far this rally (speed escalation)
000000r 2               CUR_DELAY       := $48   ; current SysDelay centiseconds value, floors at MIN_DELAY
000000r 2               NEW_BALL_X      := $49   ; scratch: candidate ball position this tick
000000r 2               NEW_BALL_Y      := $4A
000000r 2               OFFSET_LO       := $4B   ; scratch: row*32+col VRAM name-table offset
000000r 2               OFFSET_HI       := $4C
000000r 2               SCAN_TMP        := $4D   ; scratch loop counter
000000r 2               SCAN_TMP2       := $4E   ; scratch loop counter (nested loops)
000000r 2               DIGIT_BUF       := $4F   ; 2 bytes, $4F-$50: ASCII tens/ones digits of a score
000000r 2               WORK_PTR        := $51   ; 2 bytes, $51-$52: string pointer for DrawString
000000r 2               STR_IDX         := $53   ; scratch: string/loop index for text-drawing routines
000000r 2               MSG_ROW         := $54   ; scratch: row argument for DrawString/ClearRow
000000r 2               START_PRESSED   := $55   ; set by PollInput when fire/space/joy-fire is down this poll
000000r 2               PREV_FIRE       := $56   ; START_PRESSED as of the previous poll (edge detection)
000000r 2               FIRE_EDGE       := $57   ; set only on the poll fire first goes down (see input.asm)
000000r 2               JOY_STATE       := $58   ; scratch: last raw ReadJoystick1/2 byte (combined where applicable)
000000r 2               JOY_STATE2      := $59   ; scratch: raw ReadJoystick2 byte, for split single-port polling
000000r 2                                         ; (PollJoy2 in gameplay's 2P mode / 1P-mode OR-into-P1 combine)
000000r 2               AI_TARGET       := $5A   ; scratch: CPU AI's desired direction this decision tick
000000r 2               CPU_TICK        := $5B   ; scratch: alternates each Tick, gates CPU AI's reaction speed
000000r 2               MENU_DIR        := $5C   ; set by PollMenuInput each poll: DIR_NONE/DIR_UP/DIR_DOWN
000000r 2               SC_TMP          := $5D   ; scratch: working copy of a score during digit conversion
000000r 2               
000000r 2               ; --- Keyboard fallback (6502-Lib's shared core/input.asm; see src/input.asm) ---
000000r 2               KB_DIR          := $5E   ; DrainKeyboardCombined output, title menu only (WASD-or-arrows)
000000r 2               KB_DIR_P1       := $5F   ; DrainKeyboardSplit output: last WASD direction seen this drain
000000r 2               KB_DIR_P2       := $60   ; DrainKeyboardSplit output: last arrow-key direction seen this drain
000000r 2               KB_FIRE         := $61   ; shared by both drain routines: 1 if space seen this drain, else 0
000000r 2               P1_KB_HOLD_TTL  := $62   ; gameplay: P1's keyboard hold-decay countdown (see PollInput)
000000r 2               P1_KB_HOLD_DIR  := $63   ; gameplay: P1's last-known WASD direction, valid while TTL nonzero
000000r 2               P2_KB_HOLD_TTL  := $64   ; gameplay: P2's keyboard hold-decay countdown (see PollInput)
000000r 2               P2_KB_HOLD_DIR  := $65   ; gameplay: P2's last-known arrow-key direction, valid while TTL nonzero
000000r 2               KB_FIRE_P1      := $66   ; required by 6502-Lib's DrainKeyboardSplit contract (space-only
000000r 2                                         ; edge); Pong doesn't act on this separately from KB_FIRE, since
000000r 2                                         ; it has one shared fire/start/pause action, not per-player fire
000000r 2               KB_FIRE_P2      := $67   ; required by 6502-Lib's DrainKeyboardSplit contract (enter-only
000000r 2                                         ; edge); same "unused, just satisfying the contract" as KB_FIRE_P1
000000r 2               
000000r 2               ; --- Playfield / paddle / ball constants ---
000000r 2               GRID_COLS         = 32
000000r 2               GRID_ROWS         = 24
000000r 2               FIELD_TOP_WALL    = 1    ; row of the top wall
000000r 2               FIELD_BOTTOM_WALL = 22   ; row of the bottom wall
000000r 2               FIELD_TOP         = 2    ; first playable row (paddle/ball travel)
000000r 2               FIELD_BOTTOM      = 21   ; last playable row
000000r 2               
000000r 2               PADDLE_HEIGHT   = 4
000000r 2               P1_X            = 2      ; left paddle column
000000r 2               P2_X            = 29     ; right paddle column
000000r 2               PADDLE_MIN_Y    = 2       ; topmost legal paddle-top row
000000r 2               PADDLE_MAX_Y    = 18      ; bottommost legal paddle-top row (21-4+1)
000000r 2               
000000r 2               BALL_START_X    = 16
000000r 2               BALL_START_Y    = 11
000000r 2               
000000r 2               BASE_DELAY      = 8      ; starting SysDelay centiseconds (~80ms/tick)
000000r 2               MIN_DELAY       = 3      ; fastest allowed (~30ms/tick), speed escalation floor
000000r 2               WIN_SCORE       = 11
000000r 2               
000000r 2               ; --- Overlay box geometry (win screen), same shape as Snake's game-over box ---
000000r 2               BOX_LEFT        = 6
000000r 2               BOX_TOP         = 8
000000r 2               BOX_WIDTH       = 20
000000r 2               BOX_HEIGHT      = 8
000000r 2               
000000r 1               
000000r 1               .segment "CART"
000000r 1               
000000r 1               .include "src/tiles.asm"
000000r 2               ; =============================================================================
000000r 2               ;   tiles.asm - Graphics I tile codes, colors, and custom 8x8 tile patterns
000000r 2               ; =============================================================================
000000r 2               ;   Same approach as the Snake cartridge: each custom tile code lives in its
000000r 2               ;   own color group (group = code>>3) so it gets an independent fg/bg pair
000000r 2               ;   without disturbing the CP437 text glyphs used by the HUD and messages.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               TILE_BLANK      = $20    ; reused CP437 space glyph, untouched
000000r 2               TILE_PADDLE     = $80    ; color group 16
000000r 2               TILE_BALL       = $88    ; color group 17
000000r 2               TILE_WALL       = $90    ; color group 18
000000r 2               TILE_FRAME      = $98    ; color group 19, win-overlay box border
000000r 2               
000000r 2               COLOR_PADDLE    = (TMS_WHITE     << 4) | TMS_BLACK
000000r 2               COLOR_BALL      = (TMS_LT_YELLOW << 4) | TMS_BLACK
000000r 2               COLOR_WALL      = (TMS_GRAY      << 4) | TMS_DK_BLUE
000000r 2               COLOR_FRAME     = (TMS_LT_YELLOW << 4) | TMS_LT_YELLOW
000000r 2               COLOR_TEXT      = (TMS_WHITE     << 4) | TMS_BLACK   ; default fill for all other groups
000000r 2               
000000r 2               ; Pattern-table destinations ($0800 base + code*8, per InitVideo's font load)
000000r 2               PATTERN_BASE    = $0800
000000r 2               PAT_PADDLE_ADDR = PATTERN_BASE + (TILE_PADDLE*8)
000000r 2               PAT_BALL_ADDR   = PATTERN_BASE + (TILE_BALL*8)
000000r 2               PAT_WALL_ADDR   = PATTERN_BASE + (TILE_WALL*8)
000000r 2               PAT_FRAME_ADDR  = PATTERN_BASE + (TILE_FRAME*8)
000000r 2               
000000r 2               .segment "CART"
000000r 2               
000000r 2               ; 8x8 bitmaps, MSB = leftmost pixel, 1 = ink
000000r 2               
000000r 2               TilePaddleData:
000000r 2  FF             .byte %11111111
000001r 2  FF             .byte %11111111
000002r 2  FF             .byte %11111111
000003r 2  FF             .byte %11111111
000004r 2  FF             .byte %11111111
000005r 2  FF             .byte %11111111
000006r 2  FF             .byte %11111111
000007r 2  FF             .byte %11111111
000008r 2               
000008r 2               TileBallData:
000008r 2  3C             .byte %00111100
000009r 2  7E             .byte %01111110
00000Ar 2  FF             .byte %11111111
00000Br 2  FF             .byte %11111111
00000Cr 2  FF             .byte %11111111
00000Dr 2  FF             .byte %11111111
00000Er 2  7E             .byte %01111110
00000Fr 2  3C             .byte %00111100
000010r 2               
000010r 2               TileWallData:
000010r 2  FF             .byte %11111111
000011r 2  FF             .byte %11111111
000012r 2  FF             .byte %11111111
000013r 2  FF             .byte %11111111
000014r 2  FF             .byte %11111111
000015r 2  FF             .byte %11111111
000016r 2  FF             .byte %11111111
000017r 2  FF             .byte %11111111
000018r 2               
000018r 2               TileFrameData:
000018r 2  FF             .byte %11111111
000019r 2  FF             .byte %11111111
00001Ar 2  FF             .byte %11111111
00001Br 2  FF             .byte %11111111
00001Cr 2  FF             .byte %11111111
00001Dr 2  FF             .byte %11111111
00001Er 2  FF             .byte %11111111
00001Fr 2  FF             .byte %11111111
000020r 2               
000020r 1               .include "src/vdp.asm"
000020r 2               ; =============================================================================
000020r 2               ;   vdp.asm - TMS9918 Graphics I mode setup and drawing primitives
000020r 2               ; =============================================================================
000020r 2               ;   Port protocol (from 6502.inc, verified against the live BIOS source):
000020r 2               ;     Set VRAM write address: addr_lo -> VC_REG, then (addr_hi | $40) -> VC_REG
000020r 2               ;     Write a VDP register:   data    -> VC_REG, then (reg#   | $80) -> VC_REG
000020r 2               ;
000020r 2               ;   THE VDP IS ITSELF AN IRQ SOURCE. Reading its status port resets the same
000020r 2               ;   two-byte write-latch that address-set and register-set writes depend on.
000020r 2               ;   An interrupt landing between the two bytes of a VC_REG write (or between
000020r 2               ;   an address-set and the data write that follows it) desyncs every VDP
000020r 2               ;   write after that point, scrambling the screen - invisible in headless
000020r 2               ;   turbo-speed testing but routine at real frame rates. Every VDP write
000020r 2               ;   sequence in this file is wrapped in PHP / SEI ... PLP (not raw SEI/CLI,
000020r 2               ;   which doesn't compose when one protected routine calls another - nesting
000020r 2               ;   PHP/SEI/PLP is safe, nesting raw SEI/CLI is not).
000020r 2               ; =============================================================================
000020r 2               
000020r 2               .segment "CART"
000020r 2               
000020r 2               ; -----------------------------------------------------------------------------
000020r 2               ; VdpWriteReg - write one VDP mode register
000020r 2               ; In: A = value, X = register number (0-7)
000020r 2               ; -----------------------------------------------------------------------------
000020r 2               VdpWriteReg:
000020r 2  08             php
000021r 2  78             sei
000022r 2  8D 01 9C       sta VC_REG
000025r 2  8A             txa
000026r 2  09 80          ora #$80
000028r 2  8D 01 9C       sta VC_REG
00002Br 2  28             plp
00002Cr 2  60             rts
00002Dr 2               
00002Dr 2               ; -----------------------------------------------------------------------------
00002Dr 2               ; VdpSetAddr - set the VRAM read/write pointer
00002Dr 2               ; In: A = address low byte, X = address high byte
00002Dr 2               ; -----------------------------------------------------------------------------
00002Dr 2               VdpSetAddr:
00002Dr 2  08             php
00002Er 2  78             sei
00002Fr 2  8D 01 9C       sta VC_REG
000032r 2  8A             txa
000033r 2  09 40          ora #$40
000035r 2  8D 01 9C       sta VC_REG
000038r 2  28             plp
000039r 2  60             rts
00003Ar 2               
00003Ar 2               ; -----------------------------------------------------------------------------
00003Ar 2               ; ComputeOffset - compute row*32+col into OFFSET_LO/OFFSET_HI
00003Ar 2               ; In: A = row (0-23), X = col (0-31)
00003Ar 2               ; Clobbers: A, Y
00003Ar 2               ; -----------------------------------------------------------------------------
00003Ar 2               ComputeOffset:
00003Ar 2  85 4B          sta OFFSET_LO
00003Cr 2  64 4C          stz OFFSET_HI
00003Er 2  A0 05          ldy #5
000040r 2               @shift:
000040r 2  06 4B          asl OFFSET_LO
000042r 2  26 4C          rol OFFSET_HI
000044r 2  88             dey
000045r 2  D0 F9          bne @shift
000047r 2  8A             txa
000048r 2  18             clc
000049r 2  65 4B          adc OFFSET_LO
00004Br 2  85 4B          sta OFFSET_LO
00004Dr 2  90 02          bcc @done
00004Fr 2  E6 4C          inc OFFSET_HI
000051r 2               @done:
000051r 2  60             rts
000052r 2               
000052r 2               ; -----------------------------------------------------------------------------
000052r 2               ; VdpSetOffsetAddr - point the VRAM write pointer at name-table offset
000052r 2               ; OFFSET_LO/OFFSET_HI (name table base is $0000, so address == offset)
000052r 2               ; -----------------------------------------------------------------------------
000052r 2               VdpSetOffsetAddr:
000052r 2  A5 4B          lda OFFSET_LO
000054r 2  A6 4C          ldx OFFSET_HI
000056r 2  4C rr rr       jmp VdpSetAddr        ; tail call - VdpSetAddr's rts returns to our caller
000059r 2               
000059r 2               ; -----------------------------------------------------------------------------
000059r 2               ; DrawTile - draw a tile code into the name table at (row,col)
000059r 2               ; In: A = row, X = col, Y = tile code
000059r 2               ;
000059r 2               ; Also atomic end-to-end (not just the address-set half): an interrupt
000059r 2               ; landing between the address-set and the data write is only harmless if
000059r 2               ; nothing else touches the VDP in between, which we can't assume - same
000059r 2               ; reasoning as VdpWriteReg above.
000059r 2               ; -----------------------------------------------------------------------------
000059r 2               DrawTile:
000059r 2  08             php
00005Ar 2  78             sei
00005Br 2  5A             phy
00005Cr 2  20 rr rr       jsr ComputeOffset
00005Fr 2  20 rr rr       jsr VdpSetOffsetAddr
000062r 2  7A             ply
000063r 2  98             tya
000064r 2  8D 00 9C       sta VC_DATA
000067r 2  28             plp
000068r 2  60             rts
000069r 2               
000069r 2               ; -----------------------------------------------------------------------------
000069r 2               ; EraseTile - draw TILE_BLANK at (row,col)
000069r 2               ; In: A = row, X = col
000069r 2               ; -----------------------------------------------------------------------------
000069r 2               EraseTile:
000069r 2  A0 20          ldy #TILE_BLANK
00006Br 2  4C rr rr       jmp DrawTile
00006Er 2               
00006Er 2               ; -----------------------------------------------------------------------------
00006Er 2               ; ClearScreen - fill all 768 name-table cells (32x24) with TILE_BLANK
00006Er 2               ; -----------------------------------------------------------------------------
00006Er 2               ClearScreen:
00006Er 2  08             php
00006Fr 2  78             sei
000070r 2  A9 00          lda #$00
000072r 2  A2 00          ldx #$00
000074r 2  20 rr rr       jsr VdpSetAddr
000077r 2  A2 00          ldx #0
000079r 2  A0 03          ldy #3
00007Br 2               @nameLoop:
00007Br 2  A9 20          lda #TILE_BLANK
00007Dr 2  8D 00 9C       sta VC_DATA
000080r 2  E8             inx
000081r 2  D0 F8          bne @nameLoop
000083r 2  88             dey
000084r 2  D0 F5          bne @nameLoop
000086r 2  28             plp
000087r 2  60             rts
000088r 2               
000088r 2               ; -----------------------------------------------------------------------------
000088r 2               ; WriteTilePatterns - copy the four custom 8x8 patterns into VRAM
000088r 2               ; -----------------------------------------------------------------------------
000088r 2               WriteTilePatterns:
000088r 2  08             php
000089r 2  78             sei
00008Ar 2  A9 00          lda #<PAT_PADDLE_ADDR
00008Cr 2  A2 0C          ldx #>PAT_PADDLE_ADDR
00008Er 2  20 rr rr       jsr VdpSetAddr
000091r 2  A0 00          ldy #0
000093r 2               @p:
000093r 2  B9 rr rr       lda TilePaddleData,y
000096r 2  8D 00 9C       sta VC_DATA
000099r 2  C8             iny
00009Ar 2  C0 08          cpy #8
00009Cr 2  D0 F5          bne @p
00009Er 2               
00009Er 2  A9 40          lda #<PAT_BALL_ADDR
0000A0r 2  A2 0C          ldx #>PAT_BALL_ADDR
0000A2r 2  20 rr rr       jsr VdpSetAddr
0000A5r 2  A0 00          ldy #0
0000A7r 2               @b:
0000A7r 2  B9 rr rr       lda TileBallData,y
0000AAr 2  8D 00 9C       sta VC_DATA
0000ADr 2  C8             iny
0000AEr 2  C0 08          cpy #8
0000B0r 2  D0 F5          bne @b
0000B2r 2               
0000B2r 2  A9 80          lda #<PAT_WALL_ADDR
0000B4r 2  A2 0C          ldx #>PAT_WALL_ADDR
0000B6r 2  20 rr rr       jsr VdpSetAddr
0000B9r 2  A0 00          ldy #0
0000BBr 2               @w:
0000BBr 2  B9 rr rr       lda TileWallData,y
0000BEr 2  8D 00 9C       sta VC_DATA
0000C1r 2  C8             iny
0000C2r 2  C0 08          cpy #8
0000C4r 2  D0 F5          bne @w
0000C6r 2               
0000C6r 2  A9 C0          lda #<PAT_FRAME_ADDR
0000C8r 2  A2 0C          ldx #>PAT_FRAME_ADDR
0000CAr 2  20 rr rr       jsr VdpSetAddr
0000CDr 2  A0 00          ldy #0
0000CFr 2               @f:
0000CFr 2  B9 rr rr       lda TileFrameData,y
0000D2r 2  8D 00 9C       sta VC_DATA
0000D5r 2  C8             iny
0000D6r 2  C0 08          cpy #8
0000D8r 2  D0 F5          bne @f
0000DAr 2  28             plp
0000DBr 2  60             rts
0000DCr 2               
0000DCr 2               ; -----------------------------------------------------------------------------
0000DCr 2               ; DrawWalls - draw the top and bottom walls across all 32 columns. Unlike a
0000DCr 2               ; bordered game there are NO side walls: columns 0 and 31 on the playable
0000DCr 2               ; rows stay blank, since that's where the ball exits to score.
0000DCr 2               ; -----------------------------------------------------------------------------
0000DCr 2               DrawWalls:
0000DCr 2  64 4D          stz SCAN_TMP
0000DEr 2               @loop:
0000DEr 2  A9 01          lda #FIELD_TOP_WALL
0000E0r 2  A6 4D          ldx SCAN_TMP
0000E2r 2  A0 90          ldy #TILE_WALL
0000E4r 2  20 rr rr       jsr DrawTile
0000E7r 2               
0000E7r 2  A9 16          lda #FIELD_BOTTOM_WALL
0000E9r 2  A6 4D          ldx SCAN_TMP
0000EBr 2  A0 90          ldy #TILE_WALL
0000EDr 2  20 rr rr       jsr DrawTile
0000F0r 2               
0000F0r 2  E6 4D          inc SCAN_TMP
0000F2r 2  A5 4D          lda SCAN_TMP
0000F4r 2  C9 20          cmp #GRID_COLS
0000F6r 2  D0 E6          bne @loop
0000F8r 2  60             rts
0000F9r 2               
0000F9r 2               ; -----------------------------------------------------------------------------
0000F9r 2               ; DrawBoxFrame - draw a TILE_FRAME outline around the win-overlay box
0000F9r 2               ; -----------------------------------------------------------------------------
0000F9r 2               DrawBoxFrame:
0000F9r 2  64 4D          stz SCAN_TMP
0000FBr 2               @topBottom:
0000FBr 2  A5 4D          lda SCAN_TMP
0000FDr 2  18             clc
0000FEr 2  69 06          adc #BOX_LEFT
000100r 2  AA             tax
000101r 2  A9 08          lda #BOX_TOP
000103r 2  A0 98          ldy #TILE_FRAME
000105r 2  20 rr rr       jsr DrawTile
000108r 2               
000108r 2  A5 4D          lda SCAN_TMP
00010Ar 2  18             clc
00010Br 2  69 06          adc #BOX_LEFT
00010Dr 2  AA             tax
00010Er 2  A9 0F          lda #(BOX_TOP+BOX_HEIGHT-1)
000110r 2  A0 98          ldy #TILE_FRAME
000112r 2  20 rr rr       jsr DrawTile
000115r 2               
000115r 2  E6 4D          inc SCAN_TMP
000117r 2  A5 4D          lda SCAN_TMP
000119r 2  C9 14          cmp #BOX_WIDTH
00011Br 2  D0 DE          bne @topBottom
00011Dr 2               
00011Dr 2  64 4D          stz SCAN_TMP
00011Fr 2               @sides:
00011Fr 2  A5 4D          lda SCAN_TMP
000121r 2  18             clc
000122r 2  69 08          adc #BOX_TOP
000124r 2  A2 06          ldx #BOX_LEFT
000126r 2  A0 98          ldy #TILE_FRAME
000128r 2  20 rr rr       jsr DrawTile
00012Br 2               
00012Br 2  A5 4D          lda SCAN_TMP
00012Dr 2  18             clc
00012Er 2  69 08          adc #BOX_TOP
000130r 2  A2 19          ldx #(BOX_LEFT+BOX_WIDTH-1)
000132r 2  A0 98          ldy #TILE_FRAME
000134r 2  20 rr rr       jsr DrawTile
000137r 2               
000137r 2  E6 4D          inc SCAN_TMP
000139r 2  A5 4D          lda SCAN_TMP
00013Br 2  C9 08          cmp #BOX_HEIGHT
00013Dr 2  D0 E0          bne @sides
00013Fr 2  60             rts
000140r 2               
000140r 2               ; -----------------------------------------------------------------------------
000140r 2               ; ClearBoxInterior - blank the win-overlay box's interior (excludes its
000140r 2               ; 1-tile frame border)
000140r 2               ; -----------------------------------------------------------------------------
000140r 2               ClearBoxInterior:
000140r 2  08             php
000141r 2  78             sei
000142r 2  A9 01          lda #1
000144r 2  85 4D          sta SCAN_TMP
000146r 2               @rowLoop:
000146r 2  A5 4D          lda SCAN_TMP
000148r 2  18             clc
000149r 2  69 08          adc #BOX_TOP
00014Br 2  A2 07          ldx #(BOX_LEFT+1)
00014Dr 2  20 rr rr       jsr ComputeOffset
000150r 2  20 rr rr       jsr VdpSetOffsetAddr
000153r 2  A0 00          ldy #0
000155r 2               @colLoop:
000155r 2  A9 20          lda #TILE_BLANK
000157r 2  8D 00 9C       sta VC_DATA
00015Ar 2  C8             iny
00015Br 2  C0 12          cpy #(BOX_WIDTH-2)
00015Dr 2  D0 F6          bne @colLoop
00015Fr 2               
00015Fr 2  E6 4D          inc SCAN_TMP
000161r 2  A5 4D          lda SCAN_TMP
000163r 2  C9 07          cmp #(BOX_HEIGHT-1)
000165r 2  D0 DF          bne @rowLoop
000167r 2  28             plp
000168r 2  60             rts
000169r 2               
000169r 2               ; -----------------------------------------------------------------------------
000169r 2               ; InitGraphicsI - switch the VDP into Graphics I mode and build the screen
000169r 2               ; -----------------------------------------------------------------------------
000169r 2               InitGraphicsI:
000169r 2  AD 0D 03       lda HW_PRESENT
00016Cr 2  29 80          and #HW_VID
00016Er 2  D0 09          bne @haveVideo
000170r 2               
000170r 2  A9 rr          lda #<NoVideoMsg
000172r 2  A0 rr          ldy #>NoVideoMsg
000174r 2  20 90 A0       jsr PrintStr
000177r 2               @haltLoop:
000177r 2  80 FE          bra @haltLoop            ; plain 65C02 has no WAI - spin forever instead
000179r 2               
000179r 2               @haveVideo:
000179r 2  08             php                      ; outer critical section for the whole setup -
00017Ar 2  78             sei                      ; covers the inline register/color-table writes
00017Br 2                                           ; below that aren't wrapped by a called routine
00017Br 2  A9 80          lda #$80
00017Dr 2  A2 01          ldx #1
00017Fr 2  20 rr rr       jsr VdpWriteReg          ; blank, 16K, Graphics I
000182r 2  A9 00          lda #$00
000184r 2  A2 00          ldx #0
000186r 2  20 rr rr       jsr VdpWriteReg
000189r 2  A9 00          lda #$00
00018Br 2  A2 02          ldx #2
00018Dr 2  20 rr rr       jsr VdpWriteReg          ; name table @ $0000
000190r 2  A9 0C          lda #$0C
000192r 2  A2 03          ldx #3
000194r 2  20 rr rr       jsr VdpWriteReg          ; color table @ $0300
000197r 2  A9 01          lda #$01
000199r 2  A2 04          ldx #4
00019Br 2  20 rr rr       jsr VdpWriteReg          ; pattern table @ $0800
00019Er 2  A9 0E          lda #$0E
0001A0r 2  A2 05          ldx #5
0001A2r 2  20 rr rr       jsr VdpWriteReg          ; sprite attrs @ $0700 (unused)
0001A5r 2  A9 01          lda #$01
0001A7r 2  A2 06          ldx #6
0001A9r 2  20 rr rr       jsr VdpWriteReg          ; sprite patterns @ $0800
0001ACr 2  A9 01          lda #TMS_BLACK
0001AEr 2  A2 07          ldx #7
0001B0r 2  20 rr rr       jsr VdpWriteReg          ; backdrop
0001B3r 2               
0001B3r 2                 ; disable the sprite list
0001B3r 2  A9 00          lda #$00
0001B5r 2  A2 07          ldx #$07
0001B7r 2  20 rr rr       jsr VdpSetAddr
0001BAr 2  A9 D0          lda #$D0
0001BCr 2  8D 00 9C       sta VC_DATA
0001BFr 2               
0001BFr 2                 ; color table: fill all 32 groups with COLOR_TEXT, then punch in our 4
0001BFr 2  A9 00          lda #$00
0001C1r 2  A2 03          ldx #$03
0001C3r 2  20 rr rr       jsr VdpSetAddr
0001C6r 2  A0 20          ldy #32
0001C8r 2               @colorLoop:
0001C8r 2  A9 F1          lda #COLOR_TEXT
0001CAr 2  8D 00 9C       sta VC_DATA
0001CDr 2  88             dey
0001CEr 2  D0 F8          bne @colorLoop
0001D0r 2               
0001D0r 2  A9 10          lda #<($0300+16)
0001D2r 2  A2 03          ldx #>($0300+16)
0001D4r 2  20 rr rr       jsr VdpSetAddr
0001D7r 2  A9 F1          lda #COLOR_PADDLE
0001D9r 2  8D 00 9C       sta VC_DATA
0001DCr 2               
0001DCr 2  A9 11          lda #<($0300+17)
0001DEr 2  A2 03          ldx #>($0300+17)
0001E0r 2  20 rr rr       jsr VdpSetAddr
0001E3r 2  A9 B1          lda #COLOR_BALL
0001E5r 2  8D 00 9C       sta VC_DATA
0001E8r 2               
0001E8r 2  A9 12          lda #<($0300+18)
0001EAr 2  A2 03          ldx #>($0300+18)
0001ECr 2  20 rr rr       jsr VdpSetAddr
0001EFr 2  A9 E4          lda #COLOR_WALL
0001F1r 2  8D 00 9C       sta VC_DATA
0001F4r 2               
0001F4r 2  A9 13          lda #<($0300+19)
0001F6r 2  A2 03          ldx #>($0300+19)
0001F8r 2  20 rr rr       jsr VdpSetAddr
0001FBr 2  A9 BB          lda #COLOR_FRAME
0001FDr 2  8D 00 9C       sta VC_DATA
000200r 2               
000200r 2  20 rr rr       jsr WriteTilePatterns
000203r 2  20 rr rr       jsr ClearScreen
000206r 2  20 rr rr       jsr DrawWalls            ; top+bottom only - no side walls, ball exits there
000209r 2               
000209r 2  A9 C0          lda #$C0
00020Br 2  A2 01          ldx #1
00020Dr 2  20 rr rr       jsr VdpWriteReg          ; unblank
000210r 2  28             plp
000211r 2  60             rts
000212r 2               
000212r 2               NoVideoMsg:
000212r 2  0D 0A 4E 4F    .byte CHAR_CR, CHAR_LF, "NO VIDEO CARD DETECTED", CHAR_CR, CHAR_LF, $00
000216r 2  20 56 49 44  
00021Ar 2  45 4F 20 43  
00022Dr 2               
00022Dr 1               .include "src/rng.asm"
00022Dr 2               ; =============================================================================
00022Dr 2               ;   rng.asm - 8-bit Galois LFSR pseudo-random generator
00022Dr 2               ; =============================================================================
00022Dr 2               ;   Same proven LFSR as the sibling Snake cartridge. RNG_STATE must never be
00022Dr 2               ;   seeded to 0 - a Galois LFSR at all-zero is a fixed point it can never
00022Dr 2               ;   leave (every subsequent shift/eor still lands on 0). Guaranteeing a
00022Dr 2               ;   non-zero seed is the CALLER's responsibility (done once in screens.asm's
00022Dr 2               ;   WaitForModeSelect), not this file's.
00022Dr 2               ; =============================================================================
00022Dr 2               
00022Dr 2               .segment "CART"
00022Dr 2               
00022Dr 2               ; -----------------------------------------------------------------------------
00022Dr 2               ; AdvanceRng - step the LFSR one bit (maximal-length, period 255)
00022Dr 2               ; -----------------------------------------------------------------------------
00022Dr 2               AdvanceRng:
00022Dr 2  A5 44          lda RNG_STATE
00022Fr 2  4A             lsr a
000230r 2  90 02          bcc @noeor
000232r 2  49 B4          eor #$B4
000234r 2               @noeor:
000234r 2  85 44          sta RNG_STATE
000236r 2  60             rts
000237r 2               
000237r 2               ; -----------------------------------------------------------------------------
000237r 2               ; RollDirection - hand back one fresh pseudo-random byte
000237r 2               ; Out: A = fresh pseudo-random byte
000237r 2               ;   Callers extract dx sign from bit 0 and reduce other bits into a small
000237r 2               ;   range themselves for dy - this routine just supplies the raw byte.
000237r 2               ; -----------------------------------------------------------------------------
000237r 2               RollDirection:
000237r 2  20 rr rr       jsr AdvanceRng
00023Ar 2  A5 44          lda RNG_STATE
00023Cr 2  60             rts
00023Dr 2               
00023Dr 1               .include "src/sound.asm"
00023Dr 2               ; =============================================================================
00023Dr 2               ;   sound.asm - non-blocking sound effects
00023Dr 2               ; =============================================================================
00023Dr 2               ;   Beep is guaranteed safe (self-no-ops with no SID card fitted) but blocks
00023Dr 2               ;   the CPU for its full ~300ms tone duration - fine for a one-off like
00023Dr 2               ;   Sound_Win, but unusable for a per-tick hit/bounce/score sound (it would
00023Dr 2               ;   freeze the whole game for a beat every time). Sound_PaddleHit,
00023Dr 2               ;   Sound_WallBounce, and Sound_Score instead drive SidPlayNote/SidSilence
00023Dr 2               ;   directly: both are plain register writes with no delay loop, so they
00023Dr 2               ;   return to the caller immediately. The SID's own envelope hardware keeps
00023Dr 2               ;   ringing the note out in real time after that - gating off right away
00023Dr 2               ;   just starts the (already short, full-sustain) release phase, it doesn't
00023Dr 2               ;   cut the sound short. All SID routines self-no-op with no SID fitted, and
00023Dr 2               ;   none of this touches the VDP, so no php/sei protection is needed here.
00023Dr 2               ; =============================================================================
00023Dr 2               
00023Dr 2               .segment "CART"
00023Dr 2               
00023Dr 2               ; -----------------------------------------------------------------------------
00023Dr 2               ; Sound_PaddleHit - short mid-high blip when the ball hits a paddle
00023Dr 2               ; -----------------------------------------------------------------------------
00023Dr 2               Sound_PaddleHit:
00023Dr 2  A9 00          lda #0
00023Fr 2  A2 D6          ldx #<SID_NOTE_A4
000241r 2  A0 1C          ldy #>SID_NOTE_A4
000243r 2  20 33 A0       jsr SidPlayNote
000246r 2  20 36 A0       jsr SidSilence
000249r 2  60             rts
00024Ar 2               
00024Ar 2               ; -----------------------------------------------------------------------------
00024Ar 2               ; Sound_WallBounce - short lower-pitched blip when the ball hits a wall
00024Ar 2               ; -----------------------------------------------------------------------------
00024Ar 2               Sound_WallBounce:
00024Ar 2  A9 00          lda #0
00024Cr 2  A2 6B          ldx #<SID_NOTE_A3
00024Er 2  A0 0E          ldy #>SID_NOTE_A3
000250r 2  20 33 A0       jsr SidPlayNote
000253r 2  20 36 A0       jsr SidSilence
000256r 2  60             rts
000257r 2               
000257r 2               ; -----------------------------------------------------------------------------
000257r 2               ; Sound_Score - short distinct blip when a point is scored
000257r 2               ; -----------------------------------------------------------------------------
000257r 2               Sound_Score:
000257r 2  A9 00          lda #0
000259r 2  A2 34          ldx #<SID_NOTE_E5
00025Br 2  A0 2B          ldy #>SID_NOTE_E5
00025Dr 2  20 33 A0       jsr SidPlayNote
000260r 2  20 36 A0       jsr SidSilence
000263r 2  60             rts
000264r 2               
000264r 2               ; -----------------------------------------------------------------------------
000264r 2               ; Sound_Win - one-time end-of-game fanfare (called at most once per game,
000264r 2               ; when a player reaches WIN_SCORE) - not a hot path, so a short blocking
000264r 2               ; arpeggio via SidPlayNote + SysDelay is fine here.
000264r 2               ; -----------------------------------------------------------------------------
000264r 2               Sound_Win:
000264r 2  A9 00          lda #0
000266r 2  A2 4B          ldx #<SID_NOTE_C5
000268r 2  A0 22          ldy #>SID_NOTE_C5
00026Ar 2  20 33 A0       jsr SidPlayNote
00026Dr 2  A9 08          lda #8
00026Fr 2  A2 00          ldx #0
000271r 2  20 75 A0       jsr SysDelay
000274r 2  20 36 A0       jsr SidSilence
000277r 2               
000277r 2  A9 00          lda #0
000279r 2  A2 34          ldx #<SID_NOTE_E5
00027Br 2  A0 2B          ldy #>SID_NOTE_E5
00027Dr 2  20 33 A0       jsr SidPlayNote
000280r 2  A9 08          lda #8
000282r 2  A2 00          ldx #0
000284r 2  20 75 A0       jsr SysDelay
000287r 2  20 36 A0       jsr SidSilence
00028Ar 2               
00028Ar 2  A9 00          lda #0
00028Cr 2  A2 61          ldx #<SID_NOTE_G5
00028Er 2  A0 33          ldy #>SID_NOTE_G5
000290r 2  20 33 A0       jsr SidPlayNote
000293r 2  A9 10          lda #16
000295r 2  A2 00          ldx #0
000297r 2  20 75 A0       jsr SysDelay
00029Ar 2  20 36 A0       jsr SidSilence
00029Dr 2  60             rts
00029Er 2               
00029Er 1               .include "src/input.asm"
00029Er 2               .segment "CART"
00029Er 2               
00029Er 2               ; =============================================================================
00029Er 2               ;   input.asm - joystick-first, keyboard-fallback polling
00029Er 2               ; =============================================================================
00029Er 2               ;   Built on 6502-Lib's shared core/input.asm (PollJoyCombined/PollJoy1/
00029Er 2               ;   PollJoy2/DrainKeyboardCombined/DrainKeyboardSplit - see that file for the
00029Er 2               ;   primitives themselves). This file only composes them into Pong's own
00029Er 2               ;   MENU_DIR/NEXT_P1/NEXT_P2/START_PRESSED, per the shared priority rule:
00029Er 2               ;   joystick first - if the joystick shows ANY direction this poll, use ONLY
00029Er 2               ;   the joystick's direction(s) this poll and don't consult the keyboard at
00029Er 2               ;   all; only fall back to the keyboard's drained result when the joystick
00029Er 2               ;   shows NOTHING this poll (including when no GPIO card is fitted at all).
00029Er 2               ;   The fire/A button is OR'd independently of that direction priority:
00029Er 2               ;   joystick A held OR keyboard space seen this drain, either one sets
00029Er 2               ;   START_PRESSED.
00029Er 2               ;
00029Er 2               ;   A cartridge owns the whole shell while it's running, so keyboard input
00029Er 2               ;   here can't collide with a BASIC prompt the way it could in a full-system
00029Er 2               ;   UI - the concern that originally motivated joystick-only design doesn't
00029Er 2               ;   apply to a cartridge. Two players sharing one keyboard use the standard
00029Er 2               ;   split: WASD is the physical left-hand cluster (P1), arrow keys are the
00029Er 2               ;   physical right-hand cluster (P2), so their hands don't collide.
00029Er 2               ;
00029Er 2               ;   Two separate polling routines, not one, because they mean different
00029Er 2               ;   things by "combine the joysticks":
00029Er 2               ;     - PollMenuInput (title/mode-select): joystick 1 and 2 are OR'd
00029Er 2               ;       together - whoever is holding a controller can navigate, since no
00029Er 2               ;       player has been assigned to a port yet - and keyboard fallback is
00029Er 2               ;       DrainKeyboardCombined (WASD or arrows, whichever was pressed most
00029Er 2               ;       recently, no player distinction, since there's no player split yet
00029Er 2               ;       either).
00029Er 2               ;     - PollInput (gameplay): joystick 1 always drives P1. Joystick 2
00029Er 2               ;       drives P2 only in 2P mode; in 1P mode physics.asm's CpuAI owns
00029Er 2               ;       NEXT_P2, and joystick 2 is instead OR'd into P1's input too, so a
00029Er 2               ;       single-player controller works from either port (same reasoning
00029Er 2               ;       as the sibling Snake cartridge). Combining both ports for P1 in
00029Er 2               ;       2P mode would be wrong - it would let either player move the
00029Er 2               ;       other's paddle - so 2P mode keeps them strictly separate. Keyboard
00029Er 2               ;       fallback is DrainKeyboardSplit: WASD drives P1's fallback ONLY,
00029Er 2               ;       arrow keys drive P2's fallback ONLY, unconditionally - never
00029Er 2               ;       combined/either-or, for the same "don't let one player move the
00029Er 2               ;       other's paddle" reason. Unlike joystick 2, arrow keys are never
00029Er 2               ;       OR'd into P1 in 1P mode: WASD is always P1's keyboard fallback,
00029Er 2               ;       arrows are always P2's, full stop; in 1P mode that just means
00029Er 2               ;       arrow keys are inert (P2 has no human player to fall back for).
00029Er 2               ;
00029Er 2               ;   Pong's paddle stops moving when nothing is pressed (unlike Snake/
00029Er 2               ;   LightCycles, which always advance forward every tick). Chrin delivers
00029Er 2               ;   discrete buffered characters, not a live "is this key down" state, and
00029Er 2               ;   it's unconfirmed whether this platform's keyboard hardware auto-repeats
00029Er 2               ;   a held key into Chrin's buffer. To feel like a held key without
00029Er 2               ;   depending on that, PollInput layers a short per-player hold-decay
00029Er 2               ;   counter (P1_KB_HOLD_TTL/P2_KB_HOLD_TTL + P1_KB_HOLD_DIR/P2_KB_HOLD_DIR,
00029Er 2               ;   zeropage.inc) on top of DrainKeyboardSplit's single-shot result: a fresh
00029Er 2               ;   direction refreshes the TTL to KB_HOLD_TTL_INIT ticks and is remembered;
00029Er 2               ;   with nothing fresh, the remembered direction keeps counting as "held"
00029Er 2               ;   for movement until the TTL counts down to 0. This bookkeeping runs
00029Er 2               ;   every tick regardless of joystick state (so Chrin never backs up and
00029Er 2               ;   the TTL stays accurate), but is only ever *applied* to NEXT_P1/NEXT_P2
00029Er 2               ;   on a tick where that player's joystick showed nothing - joystick still
00029Er 2               ;   wins outright the instant it's touched.
00029Er 2               ; =============================================================================
00029Er 2               
00029Er 2               .include "../../6502-Lib/core/input.asm"
00029Er 3               ; =============================================================================
00029Er 3               ;   input.asm - shared joystick-first, keyboard-fallback input primitives
00029Er 3               ; =============================================================================
00029Er 3               ; Caller contract:
00029Er 3               ; - Consuming project defines HW_PRESENT, HW_GPIO, ReadJoystick1,
00029Er 3               ;   ReadJoystick2, Chrin (all Kernal-provided) before including this file.
00029Er 3               ; - Consuming project defines its own DIR_UP/DIR_DOWN constants (and
00029Er 3               ;   DIR_LEFT/DIR_RIGHT, only if it's a 4-directional game) at whatever
00029Er 3               ;   numeric values it already uses - this file references them by name
00029Er 3               ;   only, so Snake/LightCycles' 0/1/2/3 and Pong's 1/2 both work unchanged.
00029Er 3               ; - Consuming project defines the zero-page output bytes each routine
00029Er 3               ;   below documents (JOY_STATE, JOY_STATE2, KB_DIR, KB_DIR_P1, KB_DIR_P2,
00029Er 3               ;   KB_FIRE, and - only if calling DrainKeyboardSplit - KB_FIRE_P1,
00029Er 3               ;   KB_FIRE_P2) before including this file, at whatever address is free.
00029Er 3               ;
00029Er 3               ; Exported routines:
00029Er 3               ; - PollJoyCombined      both ports AND-combined (single-player, either port)
00029Er 3               ; - PollJoy1 / PollJoy2  a single port, gated on HW_GPIO
00029Er 3               ; - DrainKeyboardCombined  single-player keyboard fallback (WASD or arrows)
00029Er 3               ; - DrainKeyboardSplit     two-player keyboard fallback (WASD=P1, arrows=P2)
00029Er 3               ;
00029Er 3               ; This file intentionally does NOT resolve a final NEXT_DIR/START_PRESSED -
00029Er 3               ; that composition (joystick-first priority, A-button-or-space, edge
00029Er 3               ; detection) is project-specific glue that stays in each game's own
00029Er 3               ; input.asm, since the exact target variables differ per game (NEXT_DIR vs
00029Er 3               ; NEXT_P1/NEXT_P2, single-player vs split). See docs/INPUT.md for the
00029Er 3               ; priority rule every caller should follow.
00029Er 3               ; =============================================================================
00029Er 3               
00029Er 3               ; --- Joystick bits (active-low on the wire: 0 = pressed) ---
00029Er 3               JOY_A     = %00000001
00029Er 3               JOY_B     = %00000010
00029Er 3               JOY_X     = %00000100
00029Er 3               JOY_Y     = %00001000
00029Er 3               JOY_UP    = %00010000
00029Er 3               JOY_DOWN  = %00100000
00029Er 3               JOY_LEFT  = %01000000
00029Er 3               JOY_RIGHT = %10000000
00029Er 3               
00029Er 3               ; --- Keyboard fallback scancodes ---
00029Er 3               ; Kernal delivers uppercase ASCII for letter keys; arrow keys are control
00029Er 3               ; codes, not printable characters.
00029Er 3               KEY_W           = 'W'
00029Er 3               KEY_A           = 'A'
00029Er 3               KEY_S           = 'S'
00029Er 3               KEY_D           = 'D'
00029Er 3               KEY_UP_ARROW    = $1E
00029Er 3               KEY_DOWN_ARROW  = $1F
00029Er 3               KEY_LEFT_ARROW  = $1C
00029Er 3               KEY_RIGHT_ARROW = $1D
00029Er 3               KEY_FIRE        = ' '     ; space bar: P1's fire fallback (thumb-reachable
00029Er 3                                          ; from WASD's resting position; also the
00029Er 3                                          ; traditional single-player shooter fire key)
00029Er 3               KEY_FIRE2       = $0D     ; enter/return (CHAR_CR): P2's fire fallback,
00029Er 3                                          ; sits right next to the arrow-key cluster on
00029Er 3                                          ; nearly every layout. Deliberately not a
00029Er 3                                          ; modifier key (Ctrl/Shift) -- Chrin is a plain
00029Er 3                                          ; character buffer, and modifier keys generally
00029Er 3                                          ; don't produce their own readable character,
00029Er 3                                          ; nor could left/right variants be told apart
00029Er 3                                          ; even if they did.
00029Er 3               
00029Er 3               KB_DIR_NONE = $FF          ; sentinel: no direction seen in this drain
00029Er 3               
00029Er 3               .segment "CART"
00029Er 3               
00029Er 3               ; -----------------------------------------------------------------------------
00029Er 3               ; PollJoyCombined - read both joystick ports and AND-combine them
00029Er 3               ; (active-low AND = logical OR of "pressed"), so either port drives a
00029Er 3               ; single-player game regardless of which one it's plugged into.
00029Er 3               ; Out: JOY_STATE = combined active-low byte, or $FF (idle) if no GPIO card.
00029Er 3               ; Clobbers: A
00029Er 3               ; -----------------------------------------------------------------------------
00029Er 3               PollJoyCombined:
00029Er 3  AD 0D 03       lda HW_PRESENT
0002A1r 3  29 20          and #HW_GPIO
0002A3r 3  D0 05          bne @haveGpio
0002A5r 3  A9 FF          lda #$FF
0002A7r 3  85 58          sta JOY_STATE
0002A9r 3  60             rts
0002AAr 3               @haveGpio:
0002AAr 3  20 48 A0       jsr ReadJoystick1
0002ADr 3  85 58          sta JOY_STATE
0002AFr 3  20 4B A0       jsr ReadJoystick2
0002B2r 3  25 58          and JOY_STATE
0002B4r 3  85 58          sta JOY_STATE
0002B6r 3  60             rts
0002B7r 3               
0002B7r 3               ; -----------------------------------------------------------------------------
0002B7r 3               ; PollJoy1 / PollJoy2 - read a single joystick port, gated on HW_GPIO
0002B7r 3               ; (ReadJoystick1/2 do not check hardware presence themselves - a floating
0002B7r 3               ; bus reads as meaningless data with no GPIO card fitted).
0002B7r 3               ; Out: JOY_STATE / JOY_STATE2, or $FF (idle) if no GPIO card.
0002B7r 3               ; Clobbers: A
0002B7r 3               ; -----------------------------------------------------------------------------
0002B7r 3               PollJoy1:
0002B7r 3  AD 0D 03       lda HW_PRESENT
0002BAr 3  29 20          and #HW_GPIO
0002BCr 3  D0 05          bne @haveGpio
0002BEr 3  A9 FF          lda #$FF
0002C0r 3  85 58          sta JOY_STATE
0002C2r 3  60             rts
0002C3r 3               @haveGpio:
0002C3r 3  20 48 A0       jsr ReadJoystick1
0002C6r 3  85 58          sta JOY_STATE
0002C8r 3  60             rts
0002C9r 3               
0002C9r 3               PollJoy2:
0002C9r 3  AD 0D 03       lda HW_PRESENT
0002CCr 3  29 20          and #HW_GPIO
0002CEr 3  D0 05          bne @haveGpio
0002D0r 3  A9 FF          lda #$FF
0002D2r 3  85 59          sta JOY_STATE2
0002D4r 3  60             rts
0002D5r 3               @haveGpio:
0002D5r 3  20 4B A0       jsr ReadJoystick2
0002D8r 3  85 59          sta JOY_STATE2
0002DAr 3  60             rts
0002DBr 3               
0002DBr 3               ; -----------------------------------------------------------------------------
0002DBr 3               ; DrainKeyboardCombined - single-player keyboard fallback: WASD or arrow
0002DBr 3               ; keys both work, whichever was pressed most recently in this call wins.
0002DBr 3               ; Drains every pending Chrin character each call (not just one), so a
0002DBr 3               ; burst typed between polls doesn't leave stale characters for next time.
0002DBr 3               ; LEFT/RIGHT checks compile out entirely for a 2-directional caller that
0002DBr 3               ; never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
0002DBr 3               ; Out: KB_DIR = last recognized direction this call, or KB_DIR_NONE.
0002DBr 3               ;      KB_FIRE = 1 if space or enter was seen this call, else 0. Both
0002DBr 3               ;      fire keys work interchangeably here, matching how WASD and arrows
0002DBr 3               ;      both work interchangeably for movement in this single-player case.
0002DBr 3               ; Clobbers: A
0002DBr 3               ; -----------------------------------------------------------------------------
0002DBr 3               DrainKeyboardCombined:
0002DBr 3  A9 FF          lda #KB_DIR_NONE
0002DDr 3  85 5E          sta KB_DIR
0002DFr 3  64 61          stz KB_FIRE
0002E1r 3               @drain:
0002E1r 3  20 03 A0       jsr Chrin
0002E4r 3  90 2D          bcc @done                 ; C=0 = no character waiting, buffer empty
0002E6r 3                                            ; (Chrin signals this via carry, NOT via A=0 --
0002E6r 3                                            ; A holds a character even when C=0 is possible,
0002E6r 3                                            ; so checking A for zero here would loop forever)
0002E6r 3               
0002E6r 3  C9 57          cmp #KEY_W
0002E8r 3  F0 1B          beq @setUp
0002EAr 3  C9 1E          cmp #KEY_UP_ARROW
0002ECr 3  F0 17          beq @setUp
0002EEr 3  C9 53          cmp #KEY_S
0002F0r 3  F0 1A          beq @setDown
0002F2r 3  C9 1F          cmp #KEY_DOWN_ARROW
0002F4r 3  F0 16          beq @setDown
0002F6r 3               .ifdef DIR_LEFT
0002F6r 3                 cmp #KEY_A
0002F6r 3                 beq @setLeft
0002F6r 3                 cmp #KEY_LEFT_ARROW
0002F6r 3                 beq @setLeft
0002F6r 3               .endif
0002F6r 3               .ifdef DIR_RIGHT
0002F6r 3                 cmp #KEY_D
0002F6r 3                 beq @setRight
0002F6r 3                 cmp #KEY_RIGHT_ARROW
0002F6r 3                 beq @setRight
0002F6r 3               .endif
0002F6r 3  C9 20          cmp #KEY_FIRE
0002F8r 3  F0 04          beq @setFire
0002FAr 3  C9 0D          cmp #KEY_FIRE2
0002FCr 3  D0 E3          bne @drain
0002FEr 3               @setFire:
0002FEr 3  A9 01          lda #1
000300r 3  85 61          sta KB_FIRE
000302r 3  4C rr rr       jmp @drain
000305r 3               
000305r 3               @setUp:
000305r 3  A9 01          lda #DIR_UP
000307r 3  85 5E          sta KB_DIR
000309r 3  4C rr rr       jmp @drain
00030Cr 3               @setDown:
00030Cr 3  A9 02          lda #DIR_DOWN
00030Er 3  85 5E          sta KB_DIR
000310r 3  4C rr rr       jmp @drain
000313r 3               .ifdef DIR_LEFT
000313r 3               @setLeft:
000313r 3                 lda #DIR_LEFT
000313r 3                 sta KB_DIR
000313r 3                 jmp @drain
000313r 3               .endif
000313r 3               .ifdef DIR_RIGHT
000313r 3               @setRight:
000313r 3                 lda #DIR_RIGHT
000313r 3                 sta KB_DIR
000313r 3                 jmp @drain
000313r 3               .endif
000313r 3               
000313r 3               @done:
000313r 3  60             rts
000314r 3               
000314r 3               ; -----------------------------------------------------------------------------
000314r 3               ; DrainKeyboardSplit - two-player keyboard fallback: WASD drives P1 only,
000314r 3               ; arrow keys drive P2 only, so one player's keypresses can never move the
000314r 3               ; other's paddle/cycle. Drains every pending Chrin character ONCE per
000314r 3               ; call, checking both keysets in the same pass (so both players' presses
000314r 3               ; in the same drain window are captured, not just whichever keyset was
000314r 3               ; checked first). LEFT/RIGHT checks compile out for a 2-directional caller
000314r 3               ; that never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000314r 3               ; Out: KB_DIR_P1 = last WASD direction seen this call, or KB_DIR_NONE.
000314r 3               ;      KB_DIR_P2 = last arrow-key direction seen this call, or KB_DIR_NONE.
000314r 3               ;      KB_FIRE = 1 if EITHER fire key was seen this call, else 0 - kept
000314r 3               ;      for callers with only one shared fire/start/pause action (every
000314r 3               ;      game as of this writing: "did anyone press it" is all that
000314r 3               ;      matters, mirroring how either joystick's A button already
000314r 3               ;      triggers the same shared action today).
000314r 3               ;      KB_FIRE_P1 = 1 if space (P1's fire key) was seen this call, else 0.
000314r 3               ;      KB_FIRE_P2 = 1 if enter (P2's fire key) was seen this call, else 0.
000314r 3               ;      A future game with independent per-player fire (e.g. a two-player
000314r 3               ;      shooter) reads KB_FIRE_P1/KB_FIRE_P2 instead of the combined flag.
000314r 3               ; Clobbers: A
000314r 3               ; -----------------------------------------------------------------------------
000314r 3               DrainKeyboardSplit:
000314r 3  A9 FF          lda #KB_DIR_NONE
000316r 3  85 5F          sta KB_DIR_P1
000318r 3  85 60          sta KB_DIR_P2
00031Ar 3  64 61          stz KB_FIRE
00031Cr 3  64 66          stz KB_FIRE_P1
00031Er 3  64 67          stz KB_FIRE_P2
000320r 3               @drain:
000320r 3  20 03 A0       jsr Chrin
000323r 3  90 46          bcc @done                 ; C=0 = no character waiting, buffer empty
000325r 3                                            ; (Chrin signals this via carry, NOT via A=0)
000325r 3               
000325r 3  C9 57          cmp #KEY_W
000327r 3  F0 26          beq @p1Up
000329r 3  C9 53          cmp #KEY_S
00032Br 3  F0 29          beq @p1Down
00032Dr 3               .ifdef DIR_LEFT
00032Dr 3                 cmp #KEY_A
00032Dr 3                 beq @p1Left
00032Dr 3               .endif
00032Dr 3               .ifdef DIR_RIGHT
00032Dr 3                 cmp #KEY_D
00032Dr 3                 beq @p1Right
00032Dr 3               .endif
00032Dr 3  C9 1E          cmp #KEY_UP_ARROW
00032Fr 3  F0 2C          beq @p2Up
000331r 3  C9 1F          cmp #KEY_DOWN_ARROW
000333r 3  F0 2F          beq @p2Down
000335r 3               .ifdef DIR_LEFT
000335r 3                 cmp #KEY_LEFT_ARROW
000335r 3                 beq @p2Left
000335r 3               .endif
000335r 3               .ifdef DIR_RIGHT
000335r 3                 cmp #KEY_RIGHT_ARROW
000335r 3                 beq @p2Right
000335r 3               .endif
000335r 3  C9 20          cmp #KEY_FIRE
000337r 3  F0 0D          beq @p1Fire
000339r 3  C9 0D          cmp #KEY_FIRE2
00033Br 3  D0 E3          bne @drain
00033Dr 3  A9 01          lda #1
00033Fr 3  85 61          sta KB_FIRE
000341r 3  85 67          sta KB_FIRE_P2
000343r 3  4C rr rr       jmp @drain
000346r 3               @p1Fire:
000346r 3  A9 01          lda #1
000348r 3  85 61          sta KB_FIRE
00034Ar 3  85 66          sta KB_FIRE_P1
00034Cr 3  4C rr rr       jmp @drain
00034Fr 3               
00034Fr 3               @p1Up:
00034Fr 3  A9 01          lda #DIR_UP
000351r 3  85 5F          sta KB_DIR_P1
000353r 3  4C rr rr       jmp @drain
000356r 3               @p1Down:
000356r 3  A9 02          lda #DIR_DOWN
000358r 3  85 5F          sta KB_DIR_P1
00035Ar 3  4C rr rr       jmp @drain
00035Dr 3               .ifdef DIR_LEFT
00035Dr 3               @p1Left:
00035Dr 3                 lda #DIR_LEFT
00035Dr 3                 sta KB_DIR_P1
00035Dr 3                 jmp @drain
00035Dr 3               .endif
00035Dr 3               .ifdef DIR_RIGHT
00035Dr 3               @p1Right:
00035Dr 3                 lda #DIR_RIGHT
00035Dr 3                 sta KB_DIR_P1
00035Dr 3                 jmp @drain
00035Dr 3               .endif
00035Dr 3               @p2Up:
00035Dr 3  A9 01          lda #DIR_UP
00035Fr 3  85 60          sta KB_DIR_P2
000361r 3  4C rr rr       jmp @drain
000364r 3               @p2Down:
000364r 3  A9 02          lda #DIR_DOWN
000366r 3  85 60          sta KB_DIR_P2
000368r 3  4C rr rr       jmp @drain
00036Br 3               .ifdef DIR_LEFT
00036Br 3               @p2Left:
00036Br 3                 lda #DIR_LEFT
00036Br 3                 sta KB_DIR_P2
00036Br 3                 jmp @drain
00036Br 3               .endif
00036Br 3               .ifdef DIR_RIGHT
00036Br 3               @p2Right:
00036Br 3                 lda #DIR_RIGHT
00036Br 3                 sta KB_DIR_P2
00036Br 3                 jmp @drain
00036Br 3               .endif
00036Br 3               
00036Br 3               @done:
00036Br 3  60             rts
00036Cr 3               
00036Cr 2               
00036Cr 2               ; Keyboard hold-decay window (PollInput only - see header above). At
00036Cr 2               ; BASE_DELAY (~80ms/tick) 4 ticks is ~320ms of bridged gap; at MIN_DELAY
00036Cr 2               ; (~30ms/tick, the speed-escalation floor) it's ~120ms. Long enough to
00036Cr 2               ; ride out a dropped or slow typematic character between polls, short
00036Cr 2               ; enough that a single tap doesn't feel like it holds the paddle for a
00036Cr 2               ; noticeably long time after release.
00036Cr 2               KB_HOLD_TTL_INIT = 4
00036Cr 2               
00036Cr 2               ; -----------------------------------------------------------------------------
00036Cr 2               ; PollMenuInput - title/mode-select screen only. Combines joystick 1 and 2
00036Cr 2               ; for up/down (MENU_DIR), with WASD/arrow-key keyboard fallback (whichever
00036Cr 2               ; was pressed most recently) when the joystick shows nothing. A button OR
00036Cr 2               ; space bar sets START_PRESSED, edge-detected into FIRE_EDGE same as
00036Cr 2               ; PollInput. No sticky state: MENU_DIR reflects only what's resolved THIS
00036Cr 2               ; poll (no hold-decay here - the menu doesn't need "feels held", only
00036Cr 2               ; gameplay's paddle does).
00036Cr 2               ; -----------------------------------------------------------------------------
00036Cr 2               PollMenuInput:
00036Cr 2  64 5C          stz MENU_DIR
00036Er 2  64 55          stz START_PRESSED
000370r 2               
000370r 2  20 rr rr       jsr PollJoyCombined         ; JOY_STATE = both ports OR'd, or $FF if idle/no GPIO
000373r 2  20 rr rr       jsr DrainKeyboardCombined    ; KB_DIR = last direction this drain, KB_FIRE = space seen
000376r 2               
000376r 2  A5 58          lda JOY_STATE
000378r 2  29 30          and #(JOY_UP | JOY_DOWN)
00037Ar 2  C9 30          cmp #(JOY_UP | JOY_DOWN)
00037Cr 2  F0 17          beq @useKeyboardDir          ; neither bit is 0 (pressed) -> joystick shows nothing
00037Er 2               
00037Er 2                 ; joystick shows a direction this poll: use ONLY the joystick, don't
00037Er 2                 ; consult the keyboard at all this poll
00037Er 2  A5 58          lda JOY_STATE
000380r 2  29 10          and #JOY_UP
000382r 2  D0 04          bne @notUp
000384r 2  A9 01          lda #DIR_UP
000386r 2  85 5C          sta MENU_DIR
000388r 2               @notUp:
000388r 2  A5 58          lda JOY_STATE
00038Ar 2  29 20          and #JOY_DOWN
00038Cr 2  D0 04          bne @notDown
00038Er 2  A9 02          lda #DIR_DOWN
000390r 2  85 5C          sta MENU_DIR
000392r 2               @notDown:
000392r 2  4C rr rr       jmp @fireCheck
000395r 2               
000395r 2               @useKeyboardDir:
000395r 2  A5 5E          lda KB_DIR
000397r 2  C9 FF          cmp #KB_DIR_NONE
000399r 2  F0 02          beq @fireCheck
00039Br 2  85 5C          sta MENU_DIR
00039Dr 2               
00039Dr 2               @fireCheck:
00039Dr 2  A5 58          lda JOY_STATE
00039Fr 2  29 01          and #JOY_A
0003A1r 2  F0 04          beq @setFire                 ; A pressed (bit=0)
0003A3r 2  A5 61          lda KB_FIRE
0003A5r 2  F0 04          beq @doneDrain                ; neither joystick A nor keyboard space this drain
0003A7r 2               @setFire:
0003A7r 2  A9 01          lda #1
0003A9r 2  85 55          sta START_PRESSED
0003ABr 2               
0003ABr 2               @doneDrain:
0003ABr 2  64 57          stz FIRE_EDGE
0003ADr 2  A5 56          lda PREV_FIRE
0003AFr 2  D0 06          bne @noEdge
0003B1r 2  A5 55          lda START_PRESSED
0003B3r 2  F0 02          beq @noEdge
0003B5r 2  E6 57          inc FIRE_EDGE
0003B7r 2               @noEdge:
0003B7r 2  A5 55          lda START_PRESSED
0003B9r 2  85 56          sta PREV_FIRE
0003BBr 2  60             rts
0003BCr 2               
0003BCr 2               ; -----------------------------------------------------------------------------
0003BCr 2               ; PollInput - gameplay only. Joystick 1 always drives P1; joystick 2 drives
0003BCr 2               ; P2 in 2P mode, or is OR'd into P1 in 1P mode (see header) - this joystick
0003BCr 2               ; routing is unchanged from before keyboard fallback existed. WASD/arrow-key
0003BCr 2               ; fallback (with hold-decay, see header) layers on top per player, only
0003BCr 2               ; applied on a tick where that player's joystick shows nothing. NEXT_P1/
0003BCr 2               ; NEXT_P2 are sticky "last known direction" - only overwritten when a
0003BCr 2               ; joystick bit or a valid keyboard hold is actually seen this poll, never
0003BCr 2               ; reset to DIR_NONE - Tick (physics.asm) reads them each tick to move the
0003BCr 2               ; paddles.
0003BCr 2               ; -----------------------------------------------------------------------------
0003BCr 2               PollInput:
0003BCr 2  64 55          stz START_PRESSED
0003BEr 2               
0003BEr 2  20 rr rr       jsr PollJoy1                 ; JOY_STATE = joystick1, or $FF if idle/no GPIO
0003C1r 2               
0003C1r 2  A5 3B          lda GAME_MODE
0003C3r 2  C9 01          cmp #MODE_2P
0003C5r 2  F0 09          beq @p1JoyOnly                ; 2P mode: keep the ports strictly separate
0003C7r 2               
0003C7r 2  20 rr rr       jsr PollJoy2                  ; 1P mode: OR joystick 2 into P1 too, so a
0003CAr 2  A5 59          lda JOY_STATE2                 ; single-player controller works from
0003CCr 2  25 58          and JOY_STATE                  ; either port
0003CEr 2  85 58          sta JOY_STATE
0003D0r 2               
0003D0r 2               @p1JoyOnly:
0003D0r 2  20 rr rr       jsr DrainKeyboardSplit        ; KB_DIR_P1 (WASD), KB_DIR_P2 (arrows), KB_FIRE
0003D3r 2                                                 ; drained every tick regardless of joystick
0003D3r 2                                                 ; state, so Chrin never backs up
0003D3r 2               
0003D3r 2  A5 58          lda JOY_STATE
0003D5r 2  29 30          and #(JOY_UP | JOY_DOWN)
0003D7r 2  C9 30          cmp #(JOY_UP | JOY_DOWN)
0003D9r 2  F0 2C          beq @p1JoyEmpty                ; neither bit is 0 (pressed) -> joystick empty
0003DBr 2               
0003DBr 2                 ; --- P1: joystick has a direction this poll -- use it exclusively ---
0003DBr 2  A5 58          lda JOY_STATE
0003DDr 2  29 10          and #JOY_UP
0003DFr 2  D0 04          bne @p1jNotUp
0003E1r 2  A9 01          lda #DIR_UP
0003E3r 2  85 45          sta NEXT_P1
0003E5r 2               @p1jNotUp:
0003E5r 2  A5 58          lda JOY_STATE
0003E7r 2  29 20          and #JOY_DOWN
0003E9r 2  D0 04          bne @p1jNotDown
0003EBr 2  A9 02          lda #DIR_DOWN
0003EDr 2  85 45          sta NEXT_P1
0003EFr 2               @p1jNotDown:
0003EFr 2                 ; still run keyboard bookkeeping so P1's TTL stays accurate for when the
0003EFr 2                 ; joystick lets go, but don't apply the result to NEXT_P1 this poll
0003EFr 2  A5 5F          lda KB_DIR_P1
0003F1r 2  C9 FF          cmp #KB_DIR_NONE
0003F3r 2  D0 09          bne @p1jFreshKb
0003F5r 2  A5 62          lda P1_KB_HOLD_TTL
0003F7r 2  F0 2B          beq @p1FireCheck
0003F9r 2  C6 62          dec P1_KB_HOLD_TTL
0003FBr 2  4C rr rr       jmp @p1FireCheck
0003FEr 2               @p1jFreshKb:
0003FEr 2  85 63          sta P1_KB_HOLD_DIR
000400r 2  A9 04          lda #KB_HOLD_TTL_INIT
000402r 2  85 62          sta P1_KB_HOLD_TTL
000404r 2  4C rr rr       jmp @p1FireCheck
000407r 2               
000407r 2               @p1JoyEmpty:
000407r 2                 ; --- P1: joystick shows nothing this poll -- keyboard hold-decay decides ---
000407r 2  A5 5F          lda KB_DIR_P1
000409r 2  C9 FF          cmp #KB_DIR_NONE
00040Br 2  D0 0D          bne @p1kFreshKb
00040Dr 2  A5 62          lda P1_KB_HOLD_TTL
00040Fr 2  F0 13          beq @p1FireCheck              ; already expired -> NEXT_P1 stays as-is (sticky)
000411r 2  C6 62          dec P1_KB_HOLD_TTL             ; still valid THIS tick (checked before decrementing)
000413r 2  A5 63          lda P1_KB_HOLD_DIR
000415r 2  85 45          sta NEXT_P1
000417r 2  4C rr rr       jmp @p1FireCheck
00041Ar 2               @p1kFreshKb:
00041Ar 2  85 63          sta P1_KB_HOLD_DIR
00041Cr 2  A9 04          lda #KB_HOLD_TTL_INIT
00041Er 2  85 62          sta P1_KB_HOLD_TTL
000420r 2  A5 63          lda P1_KB_HOLD_DIR
000422r 2  85 45          sta NEXT_P1
000424r 2               
000424r 2               @p1FireCheck:
000424r 2                 ; fire is independent of direction priority: joystick A OR keyboard space
000424r 2  A5 58          lda JOY_STATE
000426r 2  29 01          and #JOY_A
000428r 2  F0 04          beq @p1SetFire
00042Ar 2  A5 61          lda KB_FIRE
00042Cr 2  F0 04          beq @p1NoFire
00042Er 2               @p1SetFire:
00042Er 2  A9 01          lda #1
000430r 2  85 55          sta START_PRESSED
000432r 2               @p1NoFire:
000432r 2               
000432r 2  A5 3B          lda GAME_MODE
000434r 2  C9 01          cmp #MODE_2P
000436r 2  D0 62          bne @doneDrain                ; 1P mode: CpuAI owns NEXT_P2 and its keyboard
000438r 2                                                 ; fallback -- arrow keys stay inert here
000438r 2               
000438r 2  20 rr rr       jsr PollJoy2                  ; 2P mode: fresh read, ports strictly separate
00043Br 2               
00043Br 2  A5 59          lda JOY_STATE2
00043Dr 2  29 30          and #(JOY_UP | JOY_DOWN)
00043Fr 2  C9 30          cmp #(JOY_UP | JOY_DOWN)
000441r 2  F0 2C          beq @p2JoyEmpty
000443r 2               
000443r 2                 ; --- P2: joystick2 has a direction this poll -- use it exclusively ---
000443r 2  A5 59          lda JOY_STATE2
000445r 2  29 10          and #JOY_UP
000447r 2  D0 04          bne @p2jNotUp
000449r 2  A9 01          lda #DIR_UP
00044Br 2  85 46          sta NEXT_P2
00044Dr 2               @p2jNotUp:
00044Dr 2  A5 59          lda JOY_STATE2
00044Fr 2  29 20          and #JOY_DOWN
000451r 2  D0 04          bne @p2jNotDown
000453r 2  A9 02          lda #DIR_DOWN
000455r 2  85 46          sta NEXT_P2
000457r 2               @p2jNotDown:
000457r 2  A5 60          lda KB_DIR_P2
000459r 2  C9 FF          cmp #KB_DIR_NONE
00045Br 2  D0 09          bne @p2jFreshKb
00045Dr 2  A5 64          lda P2_KB_HOLD_TTL
00045Fr 2  F0 2B          beq @p2FireCheck
000461r 2  C6 64          dec P2_KB_HOLD_TTL
000463r 2  4C rr rr       jmp @p2FireCheck
000466r 2               @p2jFreshKb:
000466r 2  85 65          sta P2_KB_HOLD_DIR
000468r 2  A9 04          lda #KB_HOLD_TTL_INIT
00046Ar 2  85 64          sta P2_KB_HOLD_TTL
00046Cr 2  4C rr rr       jmp @p2FireCheck
00046Fr 2               
00046Fr 2               @p2JoyEmpty:
00046Fr 2                 ; --- P2: joystick2 shows nothing this poll -- keyboard hold-decay decides ---
00046Fr 2  A5 60          lda KB_DIR_P2
000471r 2  C9 FF          cmp #KB_DIR_NONE
000473r 2  D0 0D          bne @p2kFreshKb
000475r 2  A5 64          lda P2_KB_HOLD_TTL
000477r 2  F0 13          beq @p2FireCheck
000479r 2  C6 64          dec P2_KB_HOLD_TTL
00047Br 2  A5 65          lda P2_KB_HOLD_DIR
00047Dr 2  85 46          sta NEXT_P2
00047Fr 2  4C rr rr       jmp @p2FireCheck
000482r 2               @p2kFreshKb:
000482r 2  85 65          sta P2_KB_HOLD_DIR
000484r 2  A9 04          lda #KB_HOLD_TTL_INIT
000486r 2  85 64          sta P2_KB_HOLD_TTL
000488r 2  A5 65          lda P2_KB_HOLD_DIR
00048Ar 2  85 46          sta NEXT_P2
00048Cr 2               
00048Cr 2               @p2FireCheck:
00048Cr 2  A5 59          lda JOY_STATE2
00048Er 2  29 01          and #JOY_A
000490r 2  F0 04          beq @p2SetFire
000492r 2  A5 61          lda KB_FIRE
000494r 2  F0 04          beq @doneDrain
000496r 2               @p2SetFire:
000496r 2  A9 01          lda #1
000498r 2  85 55          sta START_PRESSED
00049Ar 2               
00049Ar 2               @doneDrain:
00049Ar 2                 ; Edge-detect the A button/space: FIRE_EDGE is set only on the poll it
00049Ar 2                 ; first goes down, so a held button (which reads as continuously down
00049Ar 2                 ; every poll) doesn't repeatedly re-trigger pause/resume/restart every
00049Ar 2                 ; tick.
00049Ar 2  64 57          stz FIRE_EDGE
00049Cr 2  A5 56          lda PREV_FIRE
00049Er 2  D0 06          bne @noEdge
0004A0r 2  A5 55          lda START_PRESSED
0004A2r 2  F0 02          beq @noEdge
0004A4r 2  E6 57          inc FIRE_EDGE
0004A6r 2               @noEdge:
0004A6r 2  A5 55          lda START_PRESSED
0004A8r 2  85 56          sta PREV_FIRE
0004AAr 2  60             rts
0004ABr 2               
0004ABr 1               .include "src/hud.asm"
0004ABr 2               ; =============================================================================
0004ABr 2               ;   hud.asm - HUD text/digit-drawing primitives (score, messages, title text)
0004ABr 2               ; =============================================================================
0004ABr 2               ;   Graphics I has no Kernal-compatible 40-column text mode, so all HUD text
0004ABr 2               ;   is drawn tile-by-tile straight into the name table via DrawTile/EraseTile
0004ABr 2               ;   (see src/vdp.asm), not via PrintStr/VideoPutChar. Ported near-verbatim
0004ABr 2               ;   from the same pattern used by the sibling Snake cartridge in this
0004ABr 2               ;   ecosystem.
0004ABr 2               ; =============================================================================
0004ABr 2               
0004ABr 2               .segment "CART"
0004ABr 2               
0004ABr 2               ; -----------------------------------------------------------------------------
0004ABr 2               ; DrawString
0004ABr 2               ; In:  A = row, X = col, WORK_PTR/WORK_PTR+1 = pointer to a null-terminated
0004ABr 2               ;      string
0004ABr 2               ; Draws each character of the string as consecutive tiles starting at
0004ABr 2               ; (row,col), advancing one column per character. The CP437 font's ASCII-range
0004ABr 2               ; glyphs survive InitVideo's font load into the pattern table untouched, so
0004ABr 2               ; the character code itself IS the tile code.
0004ABr 2               ; -----------------------------------------------------------------------------
0004ABr 2               DrawString:
0004ABr 2  85 54          sta MSG_ROW
0004ADr 2  86 4D          stx SCAN_TMP
0004AFr 2  A9 00          lda #0
0004B1r 2  85 53          sta STR_IDX
0004B3r 2               @loop:
0004B3r 2  A4 53          ldy STR_IDX
0004B5r 2  B1 51          lda (WORK_PTR),y
0004B7r 2  F0 0F          beq @done
0004B9r 2  A8             tay
0004BAr 2  A5 54          lda MSG_ROW
0004BCr 2  A6 4D          ldx SCAN_TMP
0004BEr 2  20 rr rr       jsr DrawTile
0004C1r 2  E6 4D          inc SCAN_TMP
0004C3r 2  E6 53          inc STR_IDX
0004C5r 2  4C rr rr       jmp @loop
0004C8r 2               @done:
0004C8r 2  60             rts
0004C9r 2               
0004C9r 2               ; -----------------------------------------------------------------------------
0004C9r 2               ; ClearRow
0004C9r 2               ; In:  A = row
0004C9r 2               ; Blanks all 32 columns of a row using EraseTile. The loop counter lives in
0004C9r 2               ; zero page rather than X/Y, since EraseTile clobbers both internally.
0004C9r 2               ; -----------------------------------------------------------------------------
0004C9r 2               ClearRow:
0004C9r 2  85 54          sta MSG_ROW
0004CBr 2  A9 00          lda #0
0004CDr 2  85 4D          sta SCAN_TMP
0004CFr 2               @loop:
0004CFr 2  A5 54          lda MSG_ROW
0004D1r 2  A6 4D          ldx SCAN_TMP
0004D3r 2  20 rr rr       jsr EraseTile
0004D6r 2  E6 4D          inc SCAN_TMP
0004D8r 2  A5 4D          lda SCAN_TMP
0004DAr 2  C9 20          cmp #GRID_COLS
0004DCr 2  D0 F1          bne @loop
0004DEr 2  60             rts
0004DFr 2               
0004DFr 2               ; -----------------------------------------------------------------------------
0004DFr 2               ; ValueToDigits2
0004DFr 2               ; In:  A = value (0-99)
0004DFr 2               ; Out: DIGIT_BUF+0 = ASCII tens digit, DIGIT_BUF+1 = ASCII ones digit
0004DFr 2               ; Repeated-subtraction decimal conversion: how many times 10 subtracts out of
0004DFr 2               ; SC_TMP before going negative is the tens digit; the remainder is the ones
0004DFr 2               ; digit. A much simpler 2-digit cousin of Snake's 16-bit 5-digit version.
0004DFr 2               ; -----------------------------------------------------------------------------
0004DFr 2               ValueToDigits2:
0004DFr 2  85 5D          sta SC_TMP
0004E1r 2  A2 00          ldx #0
0004E3r 2               @tensLoop:
0004E3r 2  A5 5D          lda SC_TMP
0004E5r 2  C9 0A          cmp #10
0004E7r 2  90 09          bcc @tensDone
0004E9r 2  38             sec
0004EAr 2  E9 0A          sbc #10
0004ECr 2  85 5D          sta SC_TMP
0004EEr 2  E8             inx
0004EFr 2  4C rr rr       jmp @tensLoop
0004F2r 2               @tensDone:
0004F2r 2  8A             txa
0004F3r 2  18             clc
0004F4r 2  69 30          adc #'0'
0004F6r 2  85 4F          sta DIGIT_BUF+0
0004F8r 2  A5 5D          lda SC_TMP
0004FAr 2  18             clc
0004FBr 2  69 30          adc #'0'
0004FDr 2  85 50          sta DIGIT_BUF+1
0004FFr 2  60             rts
000500r 2               
000500r 2               ; -----------------------------------------------------------------------------
000500r 2               ; DrawDigitBuf2
000500r 2               ; In:  A = row, X = col
000500r 2               ; Draws the 2 ASCII bytes currently in DIGIT_BUF at (row,col) and
000500r 2               ; (row,col+1), straight from DIGIT_BUF rather than via DrawString.
000500r 2               ; -----------------------------------------------------------------------------
000500r 2               DrawDigitBuf2:
000500r 2  85 54          sta MSG_ROW
000502r 2  86 4D          stx SCAN_TMP
000504r 2  A5 4F          lda DIGIT_BUF+0
000506r 2  A8             tay
000507r 2  A5 54          lda MSG_ROW
000509r 2  A6 4D          ldx SCAN_TMP
00050Br 2  20 rr rr       jsr DrawTile
00050Er 2  E6 4D          inc SCAN_TMP
000510r 2  A5 50          lda DIGIT_BUF+1
000512r 2  A8             tay
000513r 2  A5 54          lda MSG_ROW
000515r 2  A6 4D          ldx SCAN_TMP
000517r 2  20 rr rr       jsr DrawTile
00051Ar 2  60             rts
00051Br 2               
00051Br 1               .include "src/screens.asm"
00051Br 2               ; =============================================================================
00051Br 2               ;   screens.asm - Pong title/mode-select, new-game/serve, win and pause UI
00051Br 2               ; =============================================================================
00051Br 2               
00051Br 2               .segment "CART"
00051Br 2               
00051Br 2               ; -----------------------------------------------------------------------------
00051Br 2               ; DrawTitleScreen - draw the title/mode-select screen in Graphics I. Always
00051Br 2               ; a full wipe and redraw, never layered on top of whatever was there before
00051Br 2               ; (the same discipline NewGame follows) - this runs both at initial boot
00051Br 2               ; (over an already-blank screen) and again after a game over (over a live
00051Br 2               ; win-overlay box and final board state), and only clearing at the latter
00051Br 2               ; call site would leave this routine unsafe to call from anywhere else.
00051Br 2               ; Every line's starting column is (32-length)/2 for exact centering.
00051Br 2               ; -----------------------------------------------------------------------------
00051Br 2               DrawTitleScreen:
00051Br 2  20 rr rr       jsr ClearScreen
00051Er 2  20 rr rr       jsr DrawWalls
000521r 2               
000521r 2  A9 rr          lda #<TitleText
000523r 2  85 51          sta WORK_PTR
000525r 2  A9 rr          lda #>TitleText
000527r 2  85 52          sta WORK_PTR+1
000529r 2  A9 06          lda #6
00052Br 2  A2 0C          ldx #12                      ; "P O N G" is 7 chars: (32-7)/2 = 12
00052Dr 2  20 rr rr       jsr DrawString
000530r 2               
000530r 2                 ; paddle-and-ball decoration, rows 9-11: a short 3-tall bar near each
000530r 2                 ; edge of the row with the ball tile between them at the middle row
000530r 2  A9 09          lda #9
000532r 2  A2 04          ldx #4
000534r 2  A0 80          ldy #TILE_PADDLE
000536r 2  20 rr rr       jsr DrawTile
000539r 2  A9 0A          lda #10
00053Br 2  A2 04          ldx #4
00053Dr 2  A0 80          ldy #TILE_PADDLE
00053Fr 2  20 rr rr       jsr DrawTile
000542r 2  A9 0B          lda #11
000544r 2  A2 04          ldx #4
000546r 2  A0 80          ldy #TILE_PADDLE
000548r 2  20 rr rr       jsr DrawTile
00054Br 2               
00054Br 2  A9 09          lda #9
00054Dr 2  A2 1B          ldx #27
00054Fr 2  A0 80          ldy #TILE_PADDLE
000551r 2  20 rr rr       jsr DrawTile
000554r 2  A9 0A          lda #10
000556r 2  A2 1B          ldx #27
000558r 2  A0 80          ldy #TILE_PADDLE
00055Ar 2  20 rr rr       jsr DrawTile
00055Dr 2  A9 0B          lda #11
00055Fr 2  A2 1B          ldx #27
000561r 2  A0 80          ldy #TILE_PADDLE
000563r 2  20 rr rr       jsr DrawTile
000566r 2               
000566r 2  A9 0A          lda #10
000568r 2  A2 10          ldx #16
00056Ar 2  A0 88          ldy #TILE_BALL
00056Cr 2  20 rr rr       jsr DrawTile
00056Fr 2               
00056Fr 2  A9 rr          lda #<OnePlayerMsg
000571r 2  85 51          sta WORK_PTR
000573r 2  A9 rr          lda #>OnePlayerMsg
000575r 2  85 52          sta WORK_PTR+1
000577r 2  A9 0C          lda #12
000579r 2  A2 0B          ldx #11                      ; both option lines share a left-aligned
00057Br 2  20 rr rr       jsr DrawString                ; start column so the cursor lines up
00057Er 2               
00057Er 2  A9 rr          lda #<TwoPlayerMsg
000580r 2  85 51          sta WORK_PTR
000582r 2  A9 rr          lda #>TwoPlayerMsg
000584r 2  85 52          sta WORK_PTR+1
000586r 2  A9 0D          lda #13
000588r 2  A2 0B          ldx #11
00058Ar 2  20 rr rr       jsr DrawString
00058Dr 2               
00058Dr 2  A9 rr          lda #<ControlsMsg
00058Fr 2  85 51          sta WORK_PTR
000591r 2  A9 rr          lda #>ControlsMsg
000593r 2  85 52          sta WORK_PTR+1
000595r 2  A9 10          lda #16
000597r 2  A2 02          ldx #2                       ; "UP/DOWN: SELECT   A: CONFIRM" is 28 chars: (32-28)/2 = 2
000599r 2  4C rr rr       jmp DrawString
00059Cr 2               
00059Cr 2               ; -----------------------------------------------------------------------------
00059Cr 2               ; DrawMenuCursor - draw a ">" beside the option GAME_MODE currently selects
00059Cr 2               ; (MODE_1P = row 12/"ONE PLAYER", MODE_2P = row 13/"TWO PLAYERS"), erasing
00059Cr 2               ; both possible positions first so it can never leave a stale second cursor
00059Cr 2               ; behind regardless of which way the selection just changed.
00059Cr 2               ; -----------------------------------------------------------------------------
00059Cr 2               DrawMenuCursor:
00059Cr 2  A9 0C          lda #12
00059Er 2  A2 09          ldx #9
0005A0r 2  20 rr rr       jsr EraseTile
0005A3r 2  A9 0D          lda #13
0005A5r 2  A2 09          ldx #9
0005A7r 2  20 rr rr       jsr EraseTile
0005AAr 2               
0005AAr 2  A5 3B          lda GAME_MODE
0005ACr 2  C9 00          cmp #MODE_1P
0005AEr 2  D0 09          bne @row13
0005B0r 2  A9 0C          lda #12
0005B2r 2  A2 09          ldx #9
0005B4r 2  A0 3E          ldy #'>'
0005B6r 2  4C rr rr       jmp DrawTile
0005B9r 2               @row13:
0005B9r 2  A9 0D          lda #13
0005BBr 2  A2 09          ldx #9
0005BDr 2  A0 3E          ldy #'>'
0005BFr 2  4C rr rr       jmp DrawTile
0005C2r 2               
0005C2r 2               ; -----------------------------------------------------------------------------
0005C2r 2               ; WaitForModeSelect - a real up/down-navigable menu, not a direct-select
0005C2r 2               ; key: up always highlights ONE PLAYER (the top option), down always
0005C2r 2               ; highlights TWO PLAYERS (the bottom option) - with only two options,
0005C2r 2               ; "which one am I choosing" is unambiguous from the direction alone, so
0005C2r 2               ; there's no separate cursor-position state to track beyond GAME_MODE
0005C2r 2               ; itself. The A button confirms whichever is currently highlighted.
0005C2r 2               ; Increments RNG_STATE once per loop iteration while waiting (reaction-time
0005C2r 2               ; entropy for seeding), then folds in RTC-based entropy if a clock is
0005C2r 2               ; fitted, then guarantees RNG_STATE is never left at exactly 0 (a Galois
0005C2r 2               ; LFSR fixed point). Same technique as the sibling Snake cartridge's
0005C2r 2               ; title-wait loop.
0005C2r 2               ; -----------------------------------------------------------------------------
0005C2r 2               WaitForModeSelect:
0005C2r 2  64 44          stz RNG_STATE
0005C4r 2  64 3B          stz GAME_MODE                ; default highlight: ONE PLAYER
0005C6r 2  20 rr rr       jsr DrawMenuCursor
0005C9r 2               @loop:
0005C9r 2  E6 44          inc RNG_STATE
0005CBr 2  20 rr rr       jsr PollMenuInput
0005CEr 2               
0005CEr 2  A5 5C          lda MENU_DIR
0005D0r 2  C9 01          cmp #DIR_UP
0005D2r 2  D0 07          bne @notUp
0005D4r 2  A9 00          lda #MODE_1P
0005D6r 2  85 3B          sta GAME_MODE
0005D8r 2  20 rr rr       jsr DrawMenuCursor
0005DBr 2               @notUp:
0005DBr 2  A5 5C          lda MENU_DIR
0005DDr 2  C9 02          cmp #DIR_DOWN
0005DFr 2  D0 07          bne @notDown
0005E1r 2  A9 01          lda #MODE_2P
0005E3r 2  85 3B          sta GAME_MODE
0005E5r 2  20 rr rr       jsr DrawMenuCursor
0005E8r 2               @notDown:
0005E8r 2               
0005E8r 2  A5 57          lda FIRE_EDGE
0005EAr 2  F0 DD          beq @loop
0005ECr 2               
0005ECr 2  AD 0D 03       lda HW_PRESENT
0005EFr 2  29 04          and #HW_RTC
0005F1r 2  F0 11          beq @noRtc
0005F3r 2  20 5A A0       jsr RtcReadTime               ; A=hours, X=minutes, Y=seconds
0005F6r 2  45 44          eor RNG_STATE
0005F8r 2  85 44          sta RNG_STATE
0005FAr 2  8A             txa
0005FBr 2  45 44          eor RNG_STATE
0005FDr 2  85 44          sta RNG_STATE
0005FFr 2  98             tya
000600r 2  45 44          eor RNG_STATE
000602r 2  85 44          sta RNG_STATE
000604r 2               @noRtc:
000604r 2  A5 44          lda RNG_STATE
000606r 2  D0 04          bne @nonzero
000608r 2  A9 2A          lda #$2A
00060Ar 2  85 44          sta RNG_STATE
00060Cr 2               @nonzero:
00060Cr 2  60             rts
00060Dr 2               
00060Dr 2               ; -----------------------------------------------------------------------------
00060Dr 2               ; NewGame - reset for a fresh game (also used when restarting after a game
00060Dr 2               ; over, back through the title/mode-select flow). Does not touch GAME_MODE -
00060Dr 2               ; whichever mode was already selected stays selected. Always a full wipe and
00060Dr 2               ; redraw, never an incremental one: a sibling cartridge in this ecosystem had
00060Dr 2               ; a real bug where a partial restart-redraw left stale content on screen.
00060Dr 2               ; -----------------------------------------------------------------------------
00060Dr 2               NewGame:
00060Dr 2  64 42          stz P1_SCORE
00060Fr 2  64 43          stz P2_SCORE
000611r 2  64 45          stz NEXT_P1
000613r 2  64 46          stz NEXT_P2              ; DIR_NONE - KernalInit does not zero this range,
000615r 2  64 5B          stz CPU_TICK               ; so a cold boot could otherwise start with a
000617r 2                                             ; stale/garbage decision-parity or direction
000617r 2               
000617r 2  20 rr rr       jsr ClearScreen
00061Ar 2  20 rr rr       jsr DrawWalls
00061Dr 2               
00061Dr 2  A9 0A          lda #((PADDLE_MIN_Y+PADDLE_MAX_Y)/2)
00061Fr 2  85 3C          sta P1_Y
000621r 2  85 3D          sta P2_Y
000623r 2               
000623r 2  64 4D          stz SCAN_TMP
000625r 2               @drawPaddles:
000625r 2  A5 3C          lda P1_Y
000627r 2  18             clc
000628r 2  65 4D          adc SCAN_TMP
00062Ar 2  A2 02          ldx #P1_X
00062Cr 2  A0 80          ldy #TILE_PADDLE
00062Er 2  20 rr rr       jsr DrawTile
000631r 2               
000631r 2  A5 3D          lda P2_Y
000633r 2  18             clc
000634r 2  65 4D          adc SCAN_TMP
000636r 2  A2 1D          ldx #P2_X
000638r 2  A0 80          ldy #TILE_PADDLE
00063Ar 2  20 rr rr       jsr DrawTile
00063Dr 2               
00063Dr 2  E6 4D          inc SCAN_TMP
00063Fr 2  A5 4D          lda SCAN_TMP
000641r 2  C9 04          cmp #PADDLE_HEIGHT
000643r 2  D0 E0          bne @drawPaddles
000645r 2               
000645r 2  20 rr rr       jsr UpdateHud
000648r 2  20 rr rr       jsr ServeBall
00064Br 2               
00064Br 2  A9 01          lda #STATE_PLAYING
00064Dr 2  85 3A          sta GAME_STATE
00064Fr 2  60             rts
000650r 2               
000650r 2               ; -----------------------------------------------------------------------------
000650r 2               ; ServeBall - reset the ball to center court with a fresh pseudo-random
000650r 2               ; direction, undoing any speed escalation from the previous rally. Called
000650r 2               ; from NewGame and, once per point scored, from physics.asm's Tick.
000650r 2               ; -----------------------------------------------------------------------------
000650r 2               ServeBall:
000650r 2  A9 10          lda #BALL_START_X
000652r 2  85 3E          sta BALL_X
000654r 2  A9 0B          lda #BALL_START_Y
000656r 2  85 3F          sta BALL_Y
000658r 2  64 47          stz HIT_COUNT
00065Ar 2  A9 08          lda #BASE_DELAY
00065Cr 2  85 48          sta CUR_DELAY
00065Er 2               
00065Er 2  20 rr rr       jsr RollDirection
000661r 2  29 01          and #1
000663r 2  D0 07          bne @dxRight
000665r 2  A9 FF          lda #$FF
000667r 2  85 40          sta BALL_DX
000669r 2  4C rr rr       jmp @pickDy
00066Cr 2               @dxRight:
00066Cr 2  A9 01          lda #1
00066Er 2  85 40          sta BALL_DX
000670r 2               
000670r 2               @pickDy:
000670r 2  20 rr rr       jsr RollDirection
000673r 2  29 03          and #3
000675r 2  C9 00          cmp #0
000677r 2  F0 0B          beq @dyUp
000679r 2  C9 01          cmp #1
00067Br 2  F0 0E          beq @dyFlat
00067Dr 2  A9 01          lda #1                        ; 2 or 3 -> down (slight bias, fine for a serve angle)
00067Fr 2  85 41          sta BALL_DY
000681r 2  4C rr rr       jmp @drawBall
000684r 2               @dyUp:
000684r 2  A9 FF          lda #$FF
000686r 2  85 41          sta BALL_DY
000688r 2  4C rr rr       jmp @drawBall
00068Br 2               @dyFlat:
00068Br 2  64 41          stz BALL_DY
00068Dr 2               
00068Dr 2               @drawBall:
00068Dr 2  A5 3F          lda BALL_Y
00068Fr 2  A6 3E          ldx BALL_X
000691r 2  A0 88          ldy #TILE_BALL
000693r 2  20 rr rr       jsr DrawTile
000696r 2  60             rts
000697r 2               
000697r 2               ; -----------------------------------------------------------------------------
000697r 2               ; DrawWinOverlay - draw the win screen: a bordered box on top of the final
000697r 2               ; board state, same overlay technique as the sibling Snake cartridge's
000697r 2               ; game-over screen. Does not change GAME_STATE itself - the caller
000697r 2               ; (physics.asm's Tick) owns that transition.
000697r 2               ; -----------------------------------------------------------------------------
000697r 2               DrawWinOverlay:
000697r 2  20 rr rr       jsr DrawBoxFrame
00069Ar 2  20 rr rr       jsr ClearBoxInterior
00069Dr 2               
00069Dr 2  A9 rr          lda #<GameOverMsg
00069Fr 2  85 51          sta WORK_PTR
0006A1r 2  A9 rr          lda #>GameOverMsg
0006A3r 2  85 52          sta WORK_PTR+1
0006A5r 2  A9 09          lda #(BOX_TOP+1)
0006A7r 2  A2 0B          ldx #11                       ; "GAME OVER" is 9 chars, box interior is 18 wide: 7+(18-9)/2 = 11
0006A9r 2  20 rr rr       jsr DrawString
0006ACr 2               
0006ACr 2  A5 3B          lda GAME_MODE
0006AEr 2  C9 00          cmp #MODE_1P
0006B0r 2  F0 03          beq @mode1P
0006B2r 2  4C rr rr       jmp @mode2P
0006B5r 2               
0006B5r 2               @mode1P:
0006B5r 2  A5 42          lda P1_SCORE
0006B7r 2  C9 0B          cmp #WIN_SCORE
0006B9r 2  90 0B          bcc @cpuWon
0006BBr 2  A9 rr          lda #<YouWinMsg
0006BDr 2  85 51          sta WORK_PTR
0006BFr 2  A9 rr          lda #>YouWinMsg
0006C1r 2  85 52          sta WORK_PTR+1
0006C3r 2  4C rr rr       jmp @drawWinner1P
0006C6r 2               @cpuWon:
0006C6r 2  A9 rr          lda #<CpuWinsMsg
0006C8r 2  85 51          sta WORK_PTR
0006CAr 2  A9 rr          lda #>CpuWinsMsg
0006CCr 2  85 52          sta WORK_PTR+1
0006CEr 2               @drawWinner1P:
0006CEr 2  A9 0A          lda #(BOX_TOP+2)
0006D0r 2  A2 0C          ldx #12                       ; "YOU WIN!"/"CPU WINS" both 8 chars: 7+(18-8)/2 = 12
0006D2r 2  20 rr rr       jsr DrawString
0006D5r 2  4C rr rr       jmp @score
0006D8r 2               
0006D8r 2               @mode2P:
0006D8r 2  A5 42          lda P1_SCORE
0006DAr 2  C9 0B          cmp #WIN_SCORE
0006DCr 2  90 0B          bcc @p2Won
0006DEr 2  A9 rr          lda #<Player1WinsMsg
0006E0r 2  85 51          sta WORK_PTR
0006E2r 2  A9 rr          lda #>Player1WinsMsg
0006E4r 2  85 52          sta WORK_PTR+1
0006E6r 2  4C rr rr       jmp @drawWinner2P
0006E9r 2               @p2Won:
0006E9r 2  A9 rr          lda #<Player2WinsMsg
0006EBr 2  85 51          sta WORK_PTR
0006EDr 2  A9 rr          lda #>Player2WinsMsg
0006EFr 2  85 52          sta WORK_PTR+1
0006F1r 2               @drawWinner2P:
0006F1r 2  A9 0A          lda #(BOX_TOP+2)
0006F3r 2  A2 09          ldx #9                        ; "PLAYER 1/2 WINS" both 13 chars: 7+(18-13)/2 = 9
0006F5r 2  20 rr rr       jsr DrawString
0006F8r 2               
0006F8r 2               @score:
0006F8r 2  A9 rr          lda #<P1LabelMsg
0006FAr 2  85 51          sta WORK_PTR
0006FCr 2  A9 rr          lda #>P1LabelMsg
0006FEr 2  85 52          sta WORK_PTR+1
000700r 2  A9 0C          lda #(BOX_TOP+4)
000702r 2  A2 09          ldx #9                        ; "P1: NN  P2: NN" (14 chars) centered: 7+(18-14)/2 = 9
000704r 2  20 rr rr       jsr DrawString
000707r 2               
000707r 2  A5 42          lda P1_SCORE
000709r 2  20 rr rr       jsr ValueToDigits2
00070Cr 2  A9 0C          lda #(BOX_TOP+4)
00070Er 2  A2 0D          ldx #13                       ; right after "P1: " (4 chars, starts col 9)
000710r 2  20 rr rr       jsr DrawDigitBuf2
000713r 2               
000713r 2  A9 rr          lda #<P2LabelMsg
000715r 2  85 51          sta WORK_PTR
000717r 2  A9 rr          lda #>P2LabelMsg
000719r 2  85 52          sta WORK_PTR+1
00071Br 2  A9 0C          lda #(BOX_TOP+4)
00071Dr 2  A2 0F          ldx #15                       ; right after the P1 digits (2 chars, starts col 13)
00071Fr 2  20 rr rr       jsr DrawString
000722r 2               
000722r 2  A5 43          lda P2_SCORE
000724r 2  20 rr rr       jsr ValueToDigits2
000727r 2  A9 0C          lda #(BOX_TOP+4)
000729r 2  A2 15          ldx #21                       ; right after "  P2: " (6 chars, starts col 15)
00072Br 2  20 rr rr       jsr DrawDigitBuf2
00072Er 2               
00072Er 2  A9 rr          lda #<PressATitleMsg
000730r 2  85 51          sta WORK_PTR
000732r 2  A9 rr          lda #>PressATitleMsg
000734r 2  85 52          sta WORK_PTR+1
000736r 2  A9 0E          lda #(BOX_TOP+6)
000738r 2  A2 08          ldx #8                        ; "PRESS A - TITLE" is 16 chars: BOX_LEFT(6)+(20-16)/2 = 8
00073Ar 2  20 rr rr       jsr DrawString
00073Dr 2               
00073Dr 2  4C rr rr       jmp Sound_Win
000740r 2               
000740r 2               ; -----------------------------------------------------------------------------
000740r 2               ; DrawPauseMessage - draw a short paused prompt at row 23, just below the
000740r 2               ; bottom wall. Matches the sibling Snake cartridge's pause message.
000740r 2               ; -----------------------------------------------------------------------------
000740r 2               DrawPauseMessage:
000740r 2  A9 rr          lda #<PauseMsg
000742r 2  85 51          sta WORK_PTR
000744r 2  A9 rr          lda #>PauseMsg
000746r 2  85 52          sta WORK_PTR+1
000748r 2  A9 17          lda #23
00074Ar 2  A2 08          ldx #8                        ; "PAUSED - PRESS A" is 16 chars: (32-16)/2 = 8
00074Cr 2  4C rr rr       jmp DrawString
00074Fr 2               
00074Fr 2               ; =============================================================================
00074Fr 2               ;   String data
00074Fr 2               ; =============================================================================
00074Fr 2               
00074Fr 2               TitleText:
00074Fr 2  50 20 4F 20    .byte "P O N G", $00
000753r 2  4E 20 47 00  
000757r 2               
000757r 2               OnePlayerMsg:
000757r 2  4F 4E 45 20    .byte "ONE PLAYER", $00
00075Br 2  50 4C 41 59  
00075Fr 2  45 52 00     
000762r 2               
000762r 2               TwoPlayerMsg:
000762r 2  54 57 4F 20    .byte "TWO PLAYERS", $00
000766r 2  50 4C 41 59  
00076Ar 2  45 52 53 00  
00076Er 2               
00076Er 2               ControlsMsg:
00076Er 2  55 50 2F 44    .byte "UP/DOWN: SELECT   A: CONFIRM", $00
000772r 2  4F 57 4E 3A  
000776r 2  20 53 45 4C  
00078Br 2               
00078Br 2               GameOverMsg:
00078Br 2  47 41 4D 45    .byte "GAME OVER", $00
00078Fr 2  20 4F 56 45  
000793r 2  52 00        
000795r 2               
000795r 2               YouWinMsg:
000795r 2  59 4F 55 20    .byte "YOU WIN!", $00
000799r 2  57 49 4E 21  
00079Dr 2  00           
00079Er 2               
00079Er 2               CpuWinsMsg:
00079Er 2  43 50 55 20    .byte "CPU WINS", $00
0007A2r 2  57 49 4E 53  
0007A6r 2  00           
0007A7r 2               
0007A7r 2               Player1WinsMsg:
0007A7r 2  50 4C 41 59    .byte "PLAYER 1 WINS", $00
0007ABr 2  45 52 20 31  
0007AFr 2  20 57 49 4E  
0007B5r 2               
0007B5r 2               Player2WinsMsg:
0007B5r 2  50 4C 41 59    .byte "PLAYER 2 WINS", $00
0007B9r 2  45 52 20 32  
0007BDr 2  20 57 49 4E  
0007C3r 2               
0007C3r 2               P1LabelMsg:
0007C3r 2  50 31 3A 20    .byte "P1: ", $00
0007C7r 2  00           
0007C8r 2               
0007C8r 2               P2LabelMsg:
0007C8r 2  20 20 50 32    .byte "  P2: ", $00
0007CCr 2  3A 20 00     
0007CFr 2               
0007CFr 2               PressATitleMsg:
0007CFr 2  50 52 45 53    .byte "PRESS A - TITLE", $00
0007D3r 2  53 20 41 20  
0007D7r 2  2D 20 54 49  
0007DFr 2               
0007DFr 2               PauseMsg:
0007DFr 2  50 41 55 53    .byte "PAUSED - PRESS A", $00
0007E3r 2  45 44 20 2D  
0007E7r 2  20 50 52 45  
0007F0r 2               
0007F0r 1               .include "src/physics.asm"
0007F0r 2               .segment "CART"
0007F0r 2               
0007F0r 2               ; =============================================================================
0007F0r 2               ;   physics.asm - paddle movement, ball movement/collision/scoring, CPU AI
0007F0r 2               ; =============================================================================
0007F0r 2               ;   Tick is the heart of the game and walks through, in order, every tick:
0007F0r 2               ;     1. paddle movement (P1 always; P2 from a human or from CpuAI)
0007F0r 2               ;     2. compute the ball's candidate next position
0007F0r 2               ;     3. top/bottom wall bounce (may revise the candidate)
0007F0r 2               ;     4. paddle bounce, checked against the (possibly wall-revised) candidate
0007F0r 2               ;     5. scoring, only if step 4 didn't just register a bounce
0007F0r 2               ;     6. commit-and-draw the ball at its final candidate position
0007F0r 2               ;   Steps 3 and 4 are independent checks applied in sequence (not mutually
0007F0r 2               ;   exclusive) so a ball can bounce off a wall and a paddle in the very same
0007F0r 2               ;   tick near a corner. Scoring uses a strict less-than/greater-than test
0007F0r 2               ;   past each paddle's column, one step past the <=/>= test paddle collision
0007F0r 2               ;   uses at the column itself - that gap is what gives a ball that reaches a
0007F0r 2               ;   paddle's column without hitting it (a miss) one more tick to visibly sail
0007F0r 2               ;   past the edge before the point registers.
0007F0r 2               ;
0007F0r 2               ;   Both paddles are unconditionally erased-old/drawn-new every tick, even on
0007F0r 2               ;   ticks where they didn't move - a sibling cartridge in this ecosystem was
0007F0r 2               ;   bitten by stale trailing tiles when it tried to skip redraws
0007F0r 2               ;   conditionally, and the extra DrawTile/EraseTile calls are cheap.
0007F0r 2               ;
0007F0r 2               ;   SCAN_TMP/SCAN_TMP2 are reused for several unrelated things across this
0007F0r 2               ;   routine (old paddle row, erase/draw loop counters, paddle-hit row offset,
0007F0r 2               ;   the hit-this-tick flag) - safe because each use fully completes before
0007F0r 2               ;   the next one starts, but worth flagging since the names alone don't say
0007F0r 2               ;   what they hold at any given point.
0007F0r 2               ; =============================================================================
0007F0r 2               
0007F0r 2               ; -----------------------------------------------------------------------------
0007F0r 2               ; UpdateHud - redraw both players' scores and their static labels on the HUD
0007F0r 2               ; row. Called by NewGame (screens.asm) to draw the initial "0"/"0", and again
0007F0r 2               ; here by Tick whenever a score changes.
0007F0r 2               ; -----------------------------------------------------------------------------
0007F0r 2               UpdateHud:
0007F0r 2  A9 rr          lda #<P1Label
0007F2r 2  85 51          sta WORK_PTR
0007F4r 2  A9 rr          lda #>P1Label
0007F6r 2  85 52          sta WORK_PTR+1
0007F8r 2  A9 00          lda #0
0007FAr 2  A2 02          ldx #2
0007FCr 2  20 rr rr       jsr DrawString
0007FFr 2               
0007FFr 2  A5 42          lda P1_SCORE
000801r 2  20 rr rr       jsr ValueToDigits2
000804r 2  A9 00          lda #0
000806r 2  A2 06          ldx #6
000808r 2  20 rr rr       jsr DrawDigitBuf2
00080Br 2               
00080Br 2  A9 rr          lda #<P2Label
00080Dr 2  85 51          sta WORK_PTR
00080Fr 2  A9 rr          lda #>P2Label
000811r 2  85 52          sta WORK_PTR+1
000813r 2  A9 00          lda #0
000815r 2  A2 18          ldx #24
000817r 2  20 rr rr       jsr DrawString
00081Ar 2               
00081Ar 2  A5 43          lda P2_SCORE
00081Cr 2  20 rr rr       jsr ValueToDigits2
00081Fr 2  A9 00          lda #0
000821r 2  A2 1C          ldx #28
000823r 2  20 rr rr       jsr DrawDigitBuf2
000826r 2  60             rts
000827r 2               
000827r 2               ; -----------------------------------------------------------------------------
000827r 2               ; CpuAI - steers NEXT_P2 toward the ball. Only called when GAME_MODE ==
000827r 2               ; MODE_1P (Tick gates the call, but this checks again defensively). Only
000827r 2               ; recomputes its decision on every OTHER call (bit 0 of CPU_TICK) - this
000827r 2               ; halves the CPU's effective reaction speed relative to a human who reacts
000827r 2               ; every tick, which is what makes it beatable, especially on sharp angles.
000827r 2               ;
000827r 2               ; Because a decision only happens every other tick but the paddle still
000827r 2               ; moves every tick on that stale decision, one "decision cycle" always
000827r 2               ; moves the paddle 2 rows, never 1 - so an exact BALL_Y == AI_TARGET
000827r 2               ; alignment test can permanently overshoot a single-row target every
000827r 2               ; cycle and oscillate forever without ever landing on it exactly. Fixed
000827r 2               ; with a 3-row deadband (AI_TARGET-1 .. AI_TARGET+1 counts as "aligned")
000827r 2               ; instead of exact equality - wide enough that a 2-row swing can't jump
000827r 2               ; over it, and still narrow enough that the ball stays within the
000827r 2               ; paddle's 4-row catch range once the AI settles.
000827r 2               ; -----------------------------------------------------------------------------
000827r 2               CpuAI:
000827r 2  A5 3B          lda GAME_MODE
000829r 2  C9 00          cmp #MODE_1P
00082Br 2  D0 35          bne @done                      ; belt-and-suspenders - Tick already gates this call
00082Dr 2               
00082Dr 2  E6 5B          inc CPU_TICK
00082Fr 2  A5 5B          lda CPU_TICK
000831r 2  29 01          and #1
000833r 2  D0 2D          bne @done                      ; odd tick: skip deciding, leave NEXT_P2 as it was
000835r 2               
000835r 2  A5 3D          lda P2_Y
000837r 2  18             clc
000838r 2  69 01          adc #1                         ; reference point: roughly the paddle's vertical center
00083Ar 2  85 5A          sta AI_TARGET
00083Cr 2               
00083Cr 2  A5 3F          lda BALL_Y
00083Er 2  C5 5A          cmp AI_TARGET
000840r 2  90 0D          bcc @ballAbove                 ; BALL_Y < AI_TARGET: ball is above the paddle's center
000842r 2  38             sec
000843r 2  E5 5A          sbc AI_TARGET                  ; A = BALL_Y - AI_TARGET, >= 0 here
000845r 2  C9 02          cmp #2
000847r 2  90 15          bcc @aligned                   ; within [AI_TARGET, AI_TARGET+1] - close enough
000849r 2  A9 02          lda #DIR_DOWN
00084Br 2  85 46          sta NEXT_P2
00084Dr 2  80 13          bra @done
00084Fr 2               @ballAbove:
00084Fr 2  A5 5A          lda AI_TARGET
000851r 2  38             sec
000852r 2  E5 3F          sbc BALL_Y                     ; A = AI_TARGET - BALL_Y, > 0 here
000854r 2  C9 02          cmp #2
000856r 2  90 06          bcc @aligned                   ; within [AI_TARGET-1, AI_TARGET) - close enough
000858r 2  A9 01          lda #DIR_UP
00085Ar 2  85 46          sta NEXT_P2
00085Cr 2  80 04          bra @done
00085Er 2               @aligned:
00085Er 2  A9 00          lda #DIR_NONE
000860r 2  85 46          sta NEXT_P2
000862r 2               @done:
000862r 2  60             rts
000863r 2               
000863r 2               ; -----------------------------------------------------------------------------
000863r 2               ; Tick - advances the game exactly one step. No inputs.
000863r 2               ; -----------------------------------------------------------------------------
000863r 2               Tick:
000863r 2               
000863r 2               ; -----------------------------------------------------------------------------
000863r 2               ; Step 1: paddle movement. P1 always moves from NEXT_P1. In 1P mode, NEXT_P2
000863r 2               ; is first recomputed by CpuAI (which only reacts every other tick); in 2P
000863r 2               ; mode NEXT_P2 is whatever PollInput last set from joystick2/arrow keys.
000863r 2               ; Either way P2 then moves from NEXT_P2 exactly like P1 moves from NEXT_P1.
000863r 2               ; -----------------------------------------------------------------------------
000863r 2  A5 3B          lda GAME_MODE
000865r 2  C9 00          cmp #MODE_1P
000867r 2  D0 03          bne @p2Ready
000869r 2  20 rr rr       jsr CpuAI
00086Cr 2               @p2Ready:
00086Cr 2               
00086Cr 2               ; --- P1 paddle: clamp-move, then erase old / draw new 4-cell column ---
00086Cr 2  A5 3C          lda P1_Y
00086Er 2  85 4D          sta SCAN_TMP                    ; remember the old top row for the erase below
000870r 2               
000870r 2  A5 45          lda NEXT_P1
000872r 2  C9 01          cmp #DIR_UP
000874r 2  D0 0A          bne @p1CheckDown
000876r 2  A5 3C          lda P1_Y
000878r 2  C9 02          cmp #PADDLE_MIN_Y
00087Ar 2  F0 12          beq @p1Redraw                   ; already at the clamp - no further move
00087Cr 2  C6 3C          dec P1_Y
00087Er 2  80 0E          bra @p1Redraw
000880r 2               @p1CheckDown:
000880r 2  A5 45          lda NEXT_P1
000882r 2  C9 02          cmp #DIR_DOWN
000884r 2  D0 08          bne @p1Redraw
000886r 2  A5 3C          lda P1_Y
000888r 2  C9 12          cmp #PADDLE_MAX_Y
00088Ar 2  F0 02          beq @p1Redraw
00088Cr 2  E6 3C          inc P1_Y
00088Er 2               
00088Er 2               @p1Redraw:
00088Er 2  A9 00          lda #0
000890r 2  85 4E          sta SCAN_TMP2
000892r 2               @p1EraseLoop:
000892r 2  A5 4D          lda SCAN_TMP
000894r 2  18             clc
000895r 2  65 4E          adc SCAN_TMP2
000897r 2  A2 02          ldx #P1_X
000899r 2  20 rr rr       jsr EraseTile
00089Cr 2  E6 4E          inc SCAN_TMP2
00089Er 2  A5 4E          lda SCAN_TMP2
0008A0r 2  C9 04          cmp #PADDLE_HEIGHT
0008A2r 2  D0 EE          bne @p1EraseLoop
0008A4r 2               
0008A4r 2  A9 00          lda #0
0008A6r 2  85 4E          sta SCAN_TMP2
0008A8r 2               @p1DrawLoop:
0008A8r 2  A5 3C          lda P1_Y
0008AAr 2  18             clc
0008ABr 2  65 4E          adc SCAN_TMP2
0008ADr 2  A2 02          ldx #P1_X
0008AFr 2  A0 80          ldy #TILE_PADDLE
0008B1r 2  20 rr rr       jsr DrawTile
0008B4r 2  E6 4E          inc SCAN_TMP2
0008B6r 2  A5 4E          lda SCAN_TMP2
0008B8r 2  C9 04          cmp #PADDLE_HEIGHT
0008BAr 2  D0 EC          bne @p1DrawLoop
0008BCr 2               
0008BCr 2               ; --- P2 paddle: identical shape, mirrored column/state ---
0008BCr 2  A5 3D          lda P2_Y
0008BEr 2  85 4D          sta SCAN_TMP
0008C0r 2               
0008C0r 2  A5 46          lda NEXT_P2
0008C2r 2  C9 01          cmp #DIR_UP
0008C4r 2  D0 0A          bne @p2CheckDown
0008C6r 2  A5 3D          lda P2_Y
0008C8r 2  C9 02          cmp #PADDLE_MIN_Y
0008CAr 2  F0 12          beq @p2Redraw
0008CCr 2  C6 3D          dec P2_Y
0008CEr 2  80 0E          bra @p2Redraw
0008D0r 2               @p2CheckDown:
0008D0r 2  A5 46          lda NEXT_P2
0008D2r 2  C9 02          cmp #DIR_DOWN
0008D4r 2  D0 08          bne @p2Redraw
0008D6r 2  A5 3D          lda P2_Y
0008D8r 2  C9 12          cmp #PADDLE_MAX_Y
0008DAr 2  F0 02          beq @p2Redraw
0008DCr 2  E6 3D          inc P2_Y
0008DEr 2               
0008DEr 2               @p2Redraw:
0008DEr 2  A9 00          lda #0
0008E0r 2  85 4E          sta SCAN_TMP2
0008E2r 2               @p2EraseLoop:
0008E2r 2  A5 4D          lda SCAN_TMP
0008E4r 2  18             clc
0008E5r 2  65 4E          adc SCAN_TMP2
0008E7r 2  A2 1D          ldx #P2_X
0008E9r 2  20 rr rr       jsr EraseTile
0008ECr 2  E6 4E          inc SCAN_TMP2
0008EEr 2  A5 4E          lda SCAN_TMP2
0008F0r 2  C9 04          cmp #PADDLE_HEIGHT
0008F2r 2  D0 EE          bne @p2EraseLoop
0008F4r 2               
0008F4r 2  A9 00          lda #0
0008F6r 2  85 4E          sta SCAN_TMP2
0008F8r 2               @p2DrawLoop:
0008F8r 2  A5 3D          lda P2_Y
0008FAr 2  18             clc
0008FBr 2  65 4E          adc SCAN_TMP2
0008FDr 2  A2 1D          ldx #P2_X
0008FFr 2  A0 80          ldy #TILE_PADDLE
000901r 2  20 rr rr       jsr DrawTile
000904r 2  E6 4E          inc SCAN_TMP2
000906r 2  A5 4E          lda SCAN_TMP2
000908r 2  C9 04          cmp #PADDLE_HEIGHT
00090Ar 2  D0 EC          bne @p2DrawLoop
00090Cr 2               
00090Cr 2               ; -----------------------------------------------------------------------------
00090Cr 2               ; Step 2: compute the ball's candidate next position. BALL_DX/BALL_DY are
00090Cr 2               ; two's-complement +-1 (DY may also be 0 when flat), so a plain CLC/ADC does
00090Cr 2               ; the right signed add - ball coordinates stay well inside the 0-31/0-23
00090Cr 2               ; range, so there's no overflow case to worry about.
00090Cr 2               ; -----------------------------------------------------------------------------
00090Cr 2  A5 3E          lda BALL_X
00090Er 2  18             clc
00090Fr 2  65 40          adc BALL_DX
000911r 2  85 49          sta NEW_BALL_X
000913r 2               
000913r 2  A5 3F          lda BALL_Y
000915r 2  18             clc
000916r 2  65 41          adc BALL_DY
000918r 2  85 4A          sta NEW_BALL_Y
00091Ar 2               
00091Ar 2               ; -----------------------------------------------------------------------------
00091Ar 2               ; Step 3: top/bottom wall collision. If the candidate row would put the ball
00091Ar 2               ; on or past a wall row, invert BALL_DY and recompute NEW_BALL_Y from the
00091Ar 2               ; ball's CURRENT (not candidate) Y using the now-inverted delta - this makes
00091Ar 2               ; the ball actually bounce away this same tick instead of re-colliding with
00091Ar 2               ; the same wall again next tick.
00091Ar 2               ; -----------------------------------------------------------------------------
00091Ar 2  A5 4A          lda NEW_BALL_Y
00091Cr 2  C9 01          cmp #FIELD_TOP_WALL
00091Er 2  90 08          bcc @wallHit                    ; NEW_BALL_Y < FIELD_TOP_WALL
000920r 2  F0 06          beq @wallHit                    ; NEW_BALL_Y == FIELD_TOP_WALL
000922r 2  C9 16          cmp #FIELD_BOTTOM_WALL
000924r 2  B0 02          bcs @wallHit                    ; NEW_BALL_Y >= FIELD_BOTTOM_WALL
000926r 2  80 1C          bra @wallDone
000928r 2               
000928r 2               @wallHit:
000928r 2  A5 41          lda BALL_DY
00092Ar 2  F0 0E          beq @wallRecompute              ; DY==0 shouldn't happen approaching a wall; leave it be
00092Cr 2  C9 01          cmp #$01
00092Er 2  D0 06          bne @wallWasNeg
000930r 2  A9 FF          lda #$FF
000932r 2  85 41          sta BALL_DY
000934r 2  80 04          bra @wallRecompute
000936r 2               @wallWasNeg:
000936r 2  A9 01          lda #$01
000938r 2  85 41          sta BALL_DY
00093Ar 2               @wallRecompute:
00093Ar 2  A5 3F          lda BALL_Y
00093Cr 2  18             clc
00093Dr 2  65 41          adc BALL_DY
00093Fr 2  85 4A          sta NEW_BALL_Y
000941r 2  20 rr rr       jsr Sound_WallBounce
000944r 2               @wallDone:
000944r 2               
000944r 2               ; -----------------------------------------------------------------------------
000944r 2               ; Step 4: paddle collision, checked after wall bouncing above is resolved -
000944r 2               ; a ball can bounce off a wall and a paddle in the very same tick near a
000944r 2               ; corner, and that's fine; the two checks are independent. Reaching a
000944r 2               ; paddle's column without landing on one of its 4 rows is a MISS, not a
000944r 2               ; bounce: nothing is inverted, and the ball falls through to the scoring
000944r 2               ; check in step 5 exactly as if no paddle were there.
000944r 2               ;
000944r 2               ; The two paddle blocks below are mirror images of each other. Branches
000944r 2               ; inside the left-paddle block target @paddleDone with JMP (it's on the far
000944r 2               ; side of the whole right-paddle block, out of BRA/Bcc range); the
000944r 2               ; right-paddle block sits immediately before @paddleDone so its own exits
000944r 2               ; can just branch there directly.
000944r 2               ; -----------------------------------------------------------------------------
000944r 2  64 4E          stz SCAN_TMP2                   ; hit-this-tick flag; step 5 below skips scoring if set
000946r 2               
000946r 2  A5 40          lda BALL_DX
000948r 2  C9 FF          cmp #$FF
00094Ar 2  F0 03          beq @leftPaddleCheck
00094Cr 2  4C rr rr       jmp @checkRightPaddle
00094Fr 2               
00094Fr 2               @leftPaddleCheck:
00094Fr 2  A5 49          lda NEW_BALL_X
000951r 2  C9 03          cmp #(P1_X+1)
000953r 2  90 03          bcc @p1CheckRow                 ; NEW_BALL_X <= P1_X
000955r 2  4C rr rr       jmp @paddleDone                 ; not at the paddle's column yet
000958r 2               @p1CheckRow:
000958r 2  A5 4A          lda NEW_BALL_Y
00095Ar 2  C5 3C          cmp P1_Y
00095Cr 2  90 38          bcc @p1Miss                     ; above the paddle's top row - miss
00095Er 2  38             sec
00095Fr 2  E5 3C          sbc P1_Y
000961r 2  C9 04          cmp #PADDLE_HEIGHT
000963r 2  B0 31          bcs @p1Miss                     ; below the paddle's bottom row - miss
000965r 2  85 4D          sta SCAN_TMP                    ; offset within the paddle, 0-3, top row first
000967r 2  A9 01          lda #$01
000969r 2  85 40          sta BALL_DX                     ; bounce away from the paddle: now moving right
00096Br 2  A5 4D          lda SCAN_TMP
00096Dr 2  C9 02          cmp #2
00096Fr 2  90 06          bcc @p1BounceUp
000971r 2  A9 01          lda #$01
000973r 2  85 41          sta BALL_DY                     ; hit the lower half of the paddle - bounce down
000975r 2  80 04          bra @p1BounceDone
000977r 2               @p1BounceUp:
000977r 2  A9 FF          lda #$FF
000979r 2  85 41          sta BALL_DY                     ; hit the upper half of the paddle - bounce up
00097Br 2               @p1BounceDone:
00097Br 2  A5 3E          lda BALL_X
00097Dr 2  18             clc
00097Er 2  65 40          adc BALL_DX
000980r 2  85 49          sta NEW_BALL_X                  ; recompute so the ball moves away this same tick
000982r 2  E6 47          inc HIT_COUNT
000984r 2  20 rr rr       jsr Sound_PaddleHit
000987r 2  A5 48          lda CUR_DELAY
000989r 2  C9 03          cmp #MIN_DELAY
00098Br 2  F0 02          beq @p1DelayFloor
00098Dr 2  C6 48          dec CUR_DELAY
00098Fr 2               @p1DelayFloor:
00098Fr 2  A9 01          lda #1
000991r 2  85 4E          sta SCAN_TMP2                   ; a hit happened this tick - step 5 skips scoring
000993r 2  4C rr rr       jmp @paddleDone
000996r 2               @p1Miss:
000996r 2  4C rr rr       jmp @paddleDone
000999r 2               
000999r 2               @checkRightPaddle:
000999r 2  A5 40          lda BALL_DX
00099Br 2  C9 01          cmp #$01
00099Dr 2  D0 43          bne @paddleDone                 ; defensive: BALL_DX should only ever be $01 or $FF
00099Fr 2  A5 49          lda NEW_BALL_X
0009A1r 2  C9 1D          cmp #P2_X
0009A3r 2  B0 02          bcs @p2CheckRow                 ; NEW_BALL_X >= P2_X
0009A5r 2  80 3B          bra @paddleDone                 ; not at the paddle's column yet
0009A7r 2               @p2CheckRow:
0009A7r 2  A5 4A          lda NEW_BALL_Y
0009A9r 2  C5 3D          cmp P2_Y
0009ABr 2  90 35          bcc @paddleDone                 ; above the paddle's top row - miss
0009ADr 2  38             sec
0009AEr 2  E5 3D          sbc P2_Y
0009B0r 2  C9 04          cmp #PADDLE_HEIGHT
0009B2r 2  B0 2E          bcs @paddleDone                 ; below the paddle's bottom row - miss
0009B4r 2  85 4D          sta SCAN_TMP
0009B6r 2  A9 FF          lda #$FF
0009B8r 2  85 40          sta BALL_DX                     ; bounce away from the paddle: now moving left
0009BAr 2  A5 4D          lda SCAN_TMP
0009BCr 2  C9 02          cmp #2
0009BEr 2  90 06          bcc @p2BounceUp
0009C0r 2  A9 01          lda #$01
0009C2r 2  85 41          sta BALL_DY
0009C4r 2  80 04          bra @p2BounceDone
0009C6r 2               @p2BounceUp:
0009C6r 2  A9 FF          lda #$FF
0009C8r 2  85 41          sta BALL_DY
0009CAr 2               @p2BounceDone:
0009CAr 2  A5 3E          lda BALL_X
0009CCr 2  18             clc
0009CDr 2  65 40          adc BALL_DX
0009CFr 2  85 49          sta NEW_BALL_X
0009D1r 2  E6 47          inc HIT_COUNT
0009D3r 2  20 rr rr       jsr Sound_PaddleHit
0009D6r 2  A5 48          lda CUR_DELAY
0009D8r 2  C9 03          cmp #MIN_DELAY
0009DAr 2  F0 02          beq @p2DelayFloor
0009DCr 2  C6 48          dec CUR_DELAY
0009DEr 2               @p2DelayFloor:
0009DEr 2  A9 01          lda #1
0009E0r 2  85 4E          sta SCAN_TMP2
0009E2r 2               
0009E2r 2               @paddleDone:
0009E2r 2               
0009E2r 2               ; -----------------------------------------------------------------------------
0009E2r 2               ; Step 5: scoring, but only if step 4 did NOT just register a paddle hit
0009E2r 2               ; this tick (SCAN_TMP2 is the hit-this-tick flag set above). Note the strict
0009E2r 2               ; </> here versus the <=/>= paddle collision used above at the same column -
0009E2r 2               ; a miss that merely reached the column needs one more tick to actually
0009E2r 2               ; cross the edge before it counts as a score.
0009E2r 2               ; -----------------------------------------------------------------------------
0009E2r 2  A5 4E          lda SCAN_TMP2
0009E4r 2  F0 03          beq @checkScoring
0009E6r 2  4C rr rr       jmp @commitBall
0009E9r 2               @checkScoring:
0009E9r 2               
0009E9r 2  A5 49          lda NEW_BALL_X
0009EBr 2  C9 02          cmp #P1_X
0009EDr 2  90 03          bcc @p2Scores                   ; NEW_BALL_X < P1_X - missed the left paddle
0009EFr 2  4C rr rr       jmp @checkRightScore
0009F2r 2               @p2Scores:
0009F2r 2  E6 43          inc P2_SCORE
0009F4r 2  20 rr rr       jsr Sound_Score
0009F7r 2  20 rr rr       jsr UpdateHud
0009FAr 2  A5 3F          lda BALL_Y
0009FCr 2  A6 3E          ldx BALL_X
0009FEr 2  20 rr rr       jsr EraseTile                   ; erase the ball's OLD position - it never reached NEW_BALL_*
000A01r 2  A5 43          lda P2_SCORE
000A03r 2  C9 0B          cmp #WIN_SCORE
000A05r 2  90 08          bcc @p2NotWin
000A07r 2  A9 03          lda #STATE_GAMEOVER
000A09r 2  85 3A          sta GAME_STATE
000A0Br 2  20 rr rr       jsr DrawWinOverlay
000A0Er 2  60             rts
000A0Fr 2               @p2NotWin:
000A0Fr 2  20 rr rr       jsr ServeBall
000A12r 2  60             rts
000A13r 2               
000A13r 2               @checkRightScore:
000A13r 2  A5 49          lda NEW_BALL_X
000A15r 2  C9 1E          cmp #(P2_X+1)
000A17r 2  B0 03          bcs @p1Scores                   ; NEW_BALL_X > P2_X - missed the right paddle
000A19r 2  4C rr rr       jmp @commitBall
000A1Cr 2               @p1Scores:
000A1Cr 2  E6 42          inc P1_SCORE
000A1Er 2  20 rr rr       jsr Sound_Score
000A21r 2  20 rr rr       jsr UpdateHud
000A24r 2  A5 3F          lda BALL_Y
000A26r 2  A6 3E          ldx BALL_X
000A28r 2  20 rr rr       jsr EraseTile
000A2Br 2  A5 42          lda P1_SCORE
000A2Dr 2  C9 0B          cmp #WIN_SCORE
000A2Fr 2  90 08          bcc @p1NotWin
000A31r 2  A9 03          lda #STATE_GAMEOVER
000A33r 2  85 3A          sta GAME_STATE
000A35r 2  20 rr rr       jsr DrawWinOverlay
000A38r 2  60             rts
000A39r 2               @p1NotWin:
000A39r 2  20 rr rr       jsr ServeBall
000A3Cr 2  60             rts
000A3Dr 2               
000A3Dr 2               ; -----------------------------------------------------------------------------
000A3Dr 2               ; Step 6: no score this tick - commit the candidate position. Reached from
000A3Dr 2               ; every non-scoring path above (straight flight, a wall bounce, a paddle
000A3Dr 2               ; bounce, or a miss that hasn't crossed the edge yet), always using whatever
000A3Dr 2               ; NEW_BALL_X/NEW_BALL_Y ended up being after any bounce recompute above.
000A3Dr 2               ; -----------------------------------------------------------------------------
000A3Dr 2               @commitBall:
000A3Dr 2  A5 3F          lda BALL_Y
000A3Fr 2  A6 3E          ldx BALL_X
000A41r 2  20 rr rr       jsr EraseTile
000A44r 2               
000A44r 2  A5 49          lda NEW_BALL_X
000A46r 2  85 3E          sta BALL_X
000A48r 2  A5 4A          lda NEW_BALL_Y
000A4Ar 2  85 3F          sta BALL_Y
000A4Cr 2               
000A4Cr 2  A5 3F          lda BALL_Y
000A4Er 2  A6 3E          ldx BALL_X
000A50r 2  A0 88          ldy #TILE_BALL
000A52r 2  20 rr rr       jsr DrawTile
000A55r 2  60             rts
000A56r 2               
000A56r 2               ; =============================================================================
000A56r 2               ;   Data - HUD label strings (null-terminated, drawn via DrawString)
000A56r 2               ; =============================================================================
000A56r 2               P1Label:
000A56r 2  50 31 3A 00    .byte "P1:", 0
000A5Ar 2               P2Label:
000A5Ar 2  50 32 3A 00    .byte "P2:", 0
000A5Er 2               
000A5Er 1               
000A5Er 1               ; =============================================================================
000A5Er 1               ;   CartReset - cartridge entry point
000A5Er 1               ; =============================================================================
000A5Er 1               CartReset:
000A5Er 1  A2 FF          ldx #$ff
000A60r 1  9A             txs                            ; Reset the stack pointer
000A61r 1  20 78 A0       jsr KernalInit                 ; Initialize all detected hardware
000A64r 1               
000A64r 1  20 30 A0       jsr Beep                       ; Startup beep (skips silently if no SID)
000A67r 1  58             cli                             ; Enable interrupts
000A68r 1               
000A68r 1  20 15 A0       jsr InitVideo                  ; side effect: loads CP437 font into VRAM,
000A6Br 1                                                  ; which InitGraphicsI below depends on
000A6Br 1               
000A6Br 1  A9 00          lda #0
000A6Dr 1  20 0F A0       jsr SetIOMode                   ; video/local keyboard -- Chrin's SOURCE
000A70r 1                                                   ; follows IO_MODE too, not just Chrout's
000A70r 1                                                   ; destination, so keyboard fallback
000A70r 1                                                   ; (DrainKeyboardCombined/Split, both of
000A70r 1                                                   ; which call Chrin) would silently read
000A70r 1                                                   ; from the serial port instead of the
000A70r 1                                                   ; local keyboard if this were left at
000A70r 1                                                   ; serial mode, the stale setting from
000A70r 1                                                   ; before Pong had a keyboard fallback
000A70r 1               
000A70r 1  20 rr rr       jsr InitGraphicsI               ; also draws the top/bottom walls and blanks the screen
000A73r 1  20 rr rr       jsr DrawTitleScreen
000A76r 1  20 rr rr       jsr WaitForModeSelect           ; blocks until up/down + A select a mode, seeds RNG_STATE
000A79r 1               
000A79r 1  20 rr rr       jsr NewGame
000A7Cr 1               
000A7Cr 1               ; -----------------------------------------------------------------------------
000A7Cr 1               ; MainLoop
000A7Cr 1               ; -----------------------------------------------------------------------------
000A7Cr 1               MainLoop:
000A7Cr 1  20 rr rr       jsr PollInput
000A7Fr 1               
000A7Fr 1  A5 3A          lda GAME_STATE
000A81r 1  C9 01          cmp #STATE_PLAYING
000A83r 1  D0 14          bne @notPlaying
000A85r 1  A5 57          lda FIRE_EDGE
000A87r 1  F0 0A          beq @doTick
000A89r 1  A9 02          lda #STATE_PAUSED
000A8Br 1  85 3A          sta GAME_STATE
000A8Dr 1  20 rr rr       jsr DrawPauseMessage
000A90r 1  4C rr rr       jmp @delay
000A93r 1               @doTick:
000A93r 1  20 rr rr       jsr Tick
000A96r 1  4C rr rr       jmp @delay
000A99r 1               
000A99r 1               @notPlaying:
000A99r 1  C9 02          cmp #STATE_PAUSED
000A9Br 1  D0 10          bne @notPaused
000A9Dr 1  A5 57          lda FIRE_EDGE
000A9Fr 1  F0 1D          beq @delay
000AA1r 1  A9 01          lda #STATE_PLAYING
000AA3r 1  85 3A          sta GAME_STATE
000AA5r 1  A9 17          lda #23
000AA7r 1  20 rr rr       jsr ClearRow
000AAAr 1  4C rr rr       jmp @delay
000AADr 1               
000AADr 1               @notPaused:
000AADr 1  C9 03          cmp #STATE_GAMEOVER
000AAFr 1  D0 0D          bne @delay
000AB1r 1  A5 57          lda FIRE_EDGE
000AB3r 1  F0 09          beq @delay
000AB5r 1  20 rr rr       jsr DrawTitleScreen
000AB8r 1  20 rr rr       jsr WaitForModeSelect
000ABBr 1  20 rr rr       jsr NewGame
000ABEr 1               
000ABEr 1               @delay:
000ABEr 1  A5 48          lda CUR_DELAY
000AC0r 1  A2 00          ldx #0
000AC2r 1  20 75 A0       jsr SysDelay
000AC5r 1  4C rr rr       jmp MainLoop
000AC8r 1               
000AC8r 1               ; =============================================================================
000AC8r 1               ;   IRQ / NMI handlers - cartridge owns the vectors, so it must supply these.
000AC8r 1               ;   Both just dispatch through the RAM vectors KernalInit already configured
000AC8r 1               ;   (default keyboard-scanning IRQ handler, no-op NMI).
000AC8r 1               ; =============================================================================
000AC8r 1               
000AC8r 1               IrqTrampoline:
000AC8r 1  6C 00 03       jmp (IRQ_PTR)
000ACBr 1               
000ACBr 1               NmiTrampoline:
000ACBr 1  6C 04 03       jmp (NMI_PTR)
000ACEr 1               
000ACEr 1               ; =============================================================================
000ACEr 1               ;   CPU Vectors - cart owns $FFFA-$FFFF
000ACEr 1               ; =============================================================================
000ACEr 1               
000ACEr 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiTrampoline
000002r 1  rr rr        .word   CartReset
000004r 1  rr rr        .word   IrqTrampoline
000004r 1               
